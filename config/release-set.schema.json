{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logister.org/schemas/release-set.schema.json",
  "title": "Logister ecosystem release set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "backend", "impact_records", "components"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "tag": { "type": "string", "pattern": "^v[0-9]" }
      }
    },
    "impact_records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[0-9A-Za-z.-]+)?$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "baseline_version", "target_version", "bump", "release_required", "reason", "channels"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "baseline_version": { "$ref": "#/$defs/version" },
        "target_version": { "$ref": "#/$defs/version" },
        "bump": { "enum": ["none", "patch", "minor", "major"] },
        "release_required": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 12, "maxLength": 500 },
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+)*$" }
        }
      }
    }
  }
}
