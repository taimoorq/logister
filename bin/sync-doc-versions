#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "open3"
require "pathname"

repo_root = Pathname.new(__dir__).join("..").expand_path
workspace_root = Pathname.new(ENV.fetch("LOGISTER_WORKSPACE_ROOT", repo_root.dirname.to_s)).expand_path
check_only = ARGV.include?("--check")

def read_match(path, pattern)
  return nil unless path.file?

  path.read[pattern, 1]
end

def read_companion_text(workspace_root, repository, relative_path)
  repository_root = workspace_root.join(repository)
  path = repository_root.join(relative_path)
  return nil unless path.file?
  return path.read unless repository_root.join(".git").exist?

  branch, branch_status = Open3.capture2("git", "-C", repository_root.to_s, "branch", "--show-current")
  return path.read unless branch_status.success?
  return path.read if branch.strip.empty?

  # Public docs should not inherit versions from unrelated branches or uncommitted package bumps.
  reference = "main"
  if branch.strip == "main"
    dirty, dirty_status = Open3.capture2("git", "-C", repository_root.to_s, "status", "--porcelain", "--", relative_path)
    allow_dirty = ENV["LOGISTER_SYNC_DIRTY_COMPANION_VERSIONS"] == "true"
    return path.read if allow_dirty || !dirty_status.success? || dirty.strip.empty?

    reference = "HEAD"
  end

  committed_content, committed_status = Open3.capture2("git", "-C", repository_root.to_s, "show", "#{reference}:#{relative_path}")
  committed_status.success? ? committed_content : path.read
end

def read_companion_match(workspace_root, repository, relative_path, pattern)
  read_companion_text(workspace_root, repository, relative_path)&.[](pattern, 1)
end

def read_companion_json_version(workspace_root, repository, relative_path)
  content = read_companion_text(workspace_root, repository, relative_path)
  JSON.parse(content)["version"] if content
rescue JSON::ParserError
  nil
end

versions = {
  app: read_match(repo_root.join("CHANGELOG.md"), /^## (v[0-9][0-9A-Za-z.\-]*)\b/),
  ruby: read_companion_match(workspace_root, "logister-ruby", "lib/logister/version.rb", /VERSION\s*=\s*["']([^"']+)["']/),
  python: read_companion_match(workspace_root, "logister-python", "pyproject.toml", /^version\s*=\s*"([^"]+)"/),
  javascript: read_companion_json_version(workspace_root, "logister-js", "package.json"),
  dotnet: read_companion_match(workspace_root, "logister-dotnet", "src/Logister/Logister.csproj", /<Version>([^<]+)<\/Version>/),
  android: read_companion_match(workspace_root, "logister-android", "gradle.properties", /^VERSION_NAME=(.+)$/),
  ios: read_companion_match(workspace_root, "logister-ios", "VERSION", /^(.+)$/),
  cli: read_companion_json_version(workspace_root, "logister-cli", "package.json")
}.compact

def rule(name, pattern, replacement)
  { name:, pattern:, replacement: }
end

rules = []

if versions[:app]
  app = versions[:app]
  app_number = app.delete_prefix("v")
  rules.concat([
    rule("ghcr app image", /(ghcr\.io\/taimoorq\/logister:)v[0-9][0-9A-Za-z.\-]*/, "\\1#{app}"),
    rule("docker app image", /(docker\.io\/taimoorq\/logister:)v[0-9][0-9A-Za-z.\-]*/, "\\1#{app}"),
    rule("quay app image", /(quay\.io\/taimoorq\/logister:)v[0-9][0-9A-Za-z.\-]*/, "\\1#{app}"),
    rule("app gh release", /(gh release view )v[0-9][0-9A-Za-z.\-]*/, "\\1#{app}"),
    rule("app version tag example", /(version tag such as <code>)v[0-9][0-9A-Za-z.\-]*(<\/code>)/, "\\1#{app}\\2"),
    rule("app structured data version", /("softwareVersion"\s*=>\s*")[^"]+(")/, "\\1#{app_number}\\2"),
    rule("OpenAPI app version", /^(\s{2}version:\s*)[0-9][0-9A-Za-z.\-]*\s*$/, "\\1#{app_number}"),
    rule("OpenAPI server version example", /^(\s*server_version:\s*")[^"]+("\s*)$/, "\\1#{app_number}\\2"),
    rule("OpenAPI contract version example", /^(\s*api_contract_version:\s*")[^"]+("\s*)$/, "\\1#{app_number}\\2"),
    rule("server version expectation", /("server_version"\s*=>\s*")[^"]+("\s*,?)/, "\\1#{app_number}\\2"),
    rule("contract version expectation", /("api_contract_version"\s*=>\s*")[^"]+("\s*,?)/, "\\1#{app_number}\\2")
  ])
end

if versions[:cli]
  cli = versions[:cli]
  rules.concat([
    rule("recommended CLI constant", /(RECOMMENDED_CLI_VERSION\s*=\s*")[^"]+("\s*)/, "\\1#{cli}\\2"),
    rule("recommended CLI OpenAPI example", /^(\s*recommended_cli_version:\s*")[^"]+("\s*)$/, "\\1#{cli}\\2"),
    rule("recommended CLI expectation", /("recommended_cli_version"\s*=>\s*")[^"]+("\s*,?)/, "\\1#{cli}\\2")
  ])
end

if versions[:ruby]
  rules.concat([
    rule("ruby sdk parity", /(`logister-ruby` v)[0-9][0-9A-Za-z.\-]*/, "\\1#{versions[:ruby]}"),
    rule("ruby gem setup snippet", /(gem "logister-ruby", "~> )[^"]+(")/, "\\1#{versions[:ruby]}\\2")
  ])
end

if versions[:python]
  rules << rule("python sdk parity", /(`logister-python` v)[0-9][0-9A-Za-z.\-]*/, "\\1#{versions[:python]}")
end

if versions[:javascript]
  rules << rule("javascript sdk parity", /(`logister-js` v)[0-9][0-9A-Za-z.\-]*/, "\\1#{versions[:javascript]}")
end

if versions[:dotnet]
  rules << rule("dotnet sdk parity", /(`Logister` \/ `Logister\.AspNetCore` v)[0-9][0-9A-Za-z.\-]*/, "\\1#{versions[:dotnet]}")
end

if versions[:android]
  android = versions[:android]
  rules.concat([
    rule("android coordinate", /(org\.logister:logister-android:)[0-9][0-9A-Za-z.\-]*/, "\\1#{android}"),
    rule("android current version html", /(current public Android package version is <code>)[^<]+(<\/code>)/i, "\\1#{android}\\2"),
    rule("android sdk parity", /(`logister-android` v)[0-9][0-9A-Za-z.\-]*/, "\\1#{android}"),
    rule("android maven pom path", /(repo1\.maven\.org\/maven2\/org\/logister\/logister-android\/)[0-9][0-9A-Za-z.\-]*(\/logister-android-)[0-9][0-9A-Za-z.\-]*(\.pom)/, "\\1#{android}\\2#{android}\\3")
  ])
end

if versions[:ios]
  ios = versions[:ios]
  rules.concat([
    rule("ios release url", /(logister-ios\/releases\/tag\/v)[0-9][0-9A-Za-z.\-]*/, "\\1#{ios}"),
    rule("ios release link label", /(href="https:\/\/github\.com\/taimoorq\/logister-ios\/releases\/tag\/v[0-9][0-9A-Za-z.\-]*">v)[0-9][0-9A-Za-z.\-]*/, "\\1#{ios}"),
    rule("ios rails release link label", /(link_to "v)[0-9][0-9A-Za-z.\-]*(",\s*\n\s*"https:\/\/github\.com\/taimoorq\/logister-ios\/releases\/tag\/v[0-9][0-9A-Za-z.\-]*)/m, "\\1#{ios}\\2"),
    rule("ios open release label", /(Open the v)[0-9][0-9A-Za-z.\-]*( GitHub Release)/, "\\1#{ios}\\2"),
    rule("ios current version html", /(current public iOS package version is <code>)[^<]+(<\/code>)/i, "\\1#{ios}\\2"),
    rule("ios swift package version", /(\.package\(url: "https:\/\/github\.com\/taimoorq\/logister-ios\.git", from: ")[^"]+(")/, "\\1#{ios}\\2"),
    rule("ios sdk parity", /(`logister-ios` v)[0-9][0-9A-Za-z.\-]*/, "\\1#{ios}"),
    rule("ios gh release command", /(gh release view v)[0-9][0-9A-Za-z.\-]*( --repo taimoorq\/logister-ios)/, "\\1#{ios}\\2"),
    rule("ios tag command", /(iOS releases are also tag-driven:.*?git tag v)[0-9][0-9A-Za-z.\-]*/m, "\\1#{ios}"),
    rule("ios tag push command", /(iOS releases are also tag-driven:.*?git push origin v)[0-9][0-9A-Za-z.\-]*/m, "\\1#{ios}")
  ])
end

files = [
  repo_root.join("README.md"),
  repo_root.join("public/llms.txt"),
  repo_root.join("public/llms-full.txt"),
  repo_root.join("docs/mobile-add-ons.md"),
  repo_root.join("docs/openapi.yaml"),
  repo_root.join("app/services/logister/cli_capabilities.rb"),
  repo_root.join("spec/requests/api/v1/cli_capabilities_spec.rb")
]
files.concat(Dir[repo_root.join("cloudflare-docs/**/*.html")].map { |file| Pathname.new(file) })
files.concat(Dir[repo_root.join("cloudflare-docs/llms*.txt")].map { |file| Pathname.new(file) })
files.concat(Dir[repo_root.join("app/views/**/*.erb")].map { |file| Pathname.new(file) })

changed = []

files.uniq.each do |path|
  next unless path.file?

  original = path.read
  updated = original.dup
  rules.each do |version_rule|
    updated.gsub!(version_rule[:pattern], version_rule[:replacement])
  end

  next if updated == original

  changed << path.relative_path_from(repo_root).to_s
  path.write(updated) unless check_only
end

missing = %i[ruby python javascript dotnet android ios cli].reject { |key| versions[key] }
warn "Skipped missing companion repo versions: #{missing.join(", ")}" if missing.any?

if check_only && changed.any?
  warn "Version references are stale:"
  changed.each { |path| warn "  #{path}" }
  exit 1
end

puts "Version references #{check_only ? "checked" : "synced"}."
