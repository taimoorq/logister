<nav class="settings-section-nav mobile-x-scroll" aria-label="Project settings sections">
  <% section_icons = {
    "general" => :settings,
    "notifications" => :notifications,
    "team" => :team,
    "integrations" => :integrations,
    "data" => :data,
    "admin" => :admin,
    "danger" => :danger
  } %>

  <% setup_active = request.path == setup_project_path(@project) %>
  <%= link_to setup_project_path(@project),
              class: "settings-section-nav-link",
              aria: { current: ("page" if setup_active) } do %>
    <%= app_icon(:setup, css: "h-3.5 w-3.5 shrink-0") %>
    <span>Setup</span>
  <% end %>

  <% @settings_sections.each do |key, label| %>
    <% active = key == @settings_section %>
    <%= link_to settings_project_path(@project, section: key),
                class: "settings-section-nav-link",
                aria: { current: ("page" if active) } do %>
      <%= app_icon(section_icons.fetch(key, :settings), css: "h-3.5 w-3.5 shrink-0") %>
      <span><%= label %></span>
    <% end %>
  <% end %>
</nav>
