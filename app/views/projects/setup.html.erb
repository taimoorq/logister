<% tour_group = "project-setup" %>
<% plan = @setup_plan %>
<% next_item = plan.next_item %>
<% requirements = plan.groups.group_by(&:requirement) %>

<%= render layout: "shared/product_tour_frame", locals: { tour_group: tour_group } do %>

<%= render "projects/header", tour_group: tour_group %>

<section class="settings-page">
  <%= render "projects/settings_nav" %>

  <div class="setup-hub-layout">
    <div class="setup-hub" <%= tag.attributes(data: product_tour_step_data(tour_group, :checklist)) %>>
      <header class="setup-hub-header">
        <div>
          <h2>Setup</h2>
          <p>Grouped by what each step unlocks. Steps complete themselves when Logister sees the evidence.</p>
        </div>
        <ul class="setup-hub-counts" aria-label="Setup progress">
          <% { required: "badge-ok", recommended: "badge-info", optional: "badge-neutral" }.each do |requirement, badge| %>
            <% groups = requirements[requirement] %>
            <% next if groups.blank? %>
            <li class="setup-badge <%= badge %>">
              <%= requirement.to_s.capitalize %> <%= groups.sum(&:done_count) %>/<%= groups.sum(&:total) %>
            </li>
          <% end %>
        </ul>
      </header>

      <section class="setup-next" aria-labelledby="setup-next-title">
        <% if next_item %>
          <div>
            <p class="setup-kicker"><%= next_item.step.group.required? ? "Next step to go live" : "Recommended next step" %></p>
            <h3 id="setup-next-title"><%= next_item.label %></h3>
            <p><%= next_item.summary %></p>
            <p class="setup-next-owner">
              <span class="setup-owner"><%= app_icon(:account, css: "h-3.5 w-3.5") %><%= next_item.owner_label %></span>
              <span class="setup-owner"><%= next_item.action.kind == :guide ? "Done in your code or CI" : "Done in Logister" %></span>
            </p>
          </div>
          <%= link_to next_item.action.label, next_item.action.path, class: "btn-primary setup-next-action" %>
        <% elsif plan.live? %>
          <div>
            <p class="setup-kicker">All set</p>
            <h3 id="setup-next-title">Nothing left to set up right now</h3>
            <p>
              <%= @project.name %> is live, and no recommended step needs you.
              Anything waiting on your Logister admin is listed below.
            </p>
          </div>
        <% else %>
          <div>
            <p class="setup-kicker">Waiting</p>
            <h3 id="setup-next-title">The next required step needs someone else</h3>
            <p>Finish what is marked below, or ask the person named on the step.</p>
          </div>
        <% end %>
      </section>

      <% plan.groups.each_with_index do |group, index| %>
        <% heading = "#{index + 1} · #{group.label}" %>
        <% if group.complete? %>
          <details class="setup-group setup-group-complete" id="group-<%= group.key %>">
            <summary>
              <span class="setup-marker setup-marker-complete"><%= app_icon(:check, css: "h-3.5 w-3.5") %></span>
              <span class="setup-group-title"><%= heading %></span>
              <span class="setup-badge badge-ok">Complete</span>
              <span class="setup-group-count"><%= group.done_count %> of <%= group.total %></span>
            </summary>
            <ul class="setup-items">
              <% group.items.each do |item| %>
                <%= render "projects/setup_item", item: item, plan: plan, project: @project, next_item: next_item %>
              <% end %>
            </ul>
          </details>
        <% else %>
          <section class="setup-group" id="group-<%= group.key %>" aria-labelledby="group-title-<%= group.key %>">
            <header class="setup-group-header">
              <h3 id="group-title-<%= group.key %>" class="setup-group-title"><%= heading %></h3>
              <span class="setup-badge <%= { required: 'badge-ok', recommended: 'badge-info', optional: 'badge-neutral' }.fetch(group.requirement) %>"><%= group.requirement_label %></span>
              <span class="setup-group-count"><%= group.done_count %> of <%= group.total %> done</span>
              <%= link_to "Open path", setup_group_project_path(@project, group: group.key), class: "btn-ghost btn-sm ml-auto" %>
            </header>
            <ul class="setup-items">
              <% group.items.each do |item| %>
                <%= render "projects/setup_item", item: item, plan: plan, project: @project, next_item: next_item %>
              <% end %>
            </ul>
          </section>
        <% end %>
      <% end %>
    </div>

    <aside class="setup-legend" aria-labelledby="setup-legend-title">
      <p class="setup-kicker">Who does each step</p>
      <h3 id="setup-legend-title" class="sr-only">Step owners</h3>
      <dl>
        <div>
          <dt>You, Project manager</dt>
          <dd>Done here in Logister. The step opens the form.</dd>
        </div>
        <div>
          <dt>Your code, Your CI</dt>
          <dd>Done in your app or pipeline. Logister confirms it when the evidence arrives.</dd>
        </div>
        <div>
          <dt>Logister admin</dt>
          <dd>Needs an instance setting. Admins get a direct link; everyone else can copy it.</dd>
        </div>
      </dl>
      <p class="setup-legend-docs">
        <%= link_to project_integration_docs_label(@project), project_integration_docs_path(@project), target: "_blank", rel: "noopener noreferrer" %>
      </p>
    </aside>
  </div>

  <section class="grid grid-cols-1 gap-6 lg:grid-cols-2" aria-label="Credentials and guides">
    <%= render "projects/setup_api_keys", tour_group: tour_group %>
    <%= render "projects/setup_ingest_endpoint", tour_group: tour_group %>
    <% if @self_monitoring_status.linked? %>
      <%= render "projects/setup_self_monitoring_guide", status: @self_monitoring_status, tour_group: tour_group %>
    <% else %>
      <%= render "projects/setup_integration_guide", tour_group: tour_group %>
    <% end %>
  </section>
</section>
<% end %>
