<% tour_group = "project-setup" %>
<% experience = project_experience(@project) %>

<%= render layout: "shared/product_tour_frame", locals: { tour_group: tour_group } do %>

<%= render "projects/header", tour_group: tour_group %>

<section class="settings-page">
  <%= render "projects/settings_nav" %>

  <section class="settings-panel"
           <%= tag.attributes(data: product_tour_step_data(tour_group, :checklist)) %>>
    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <p class="dashboard-kicker">Setup</p>
        <h2 class="text-lg font-bold text-slate-900">Connect this project</h2>
        <p class="mt-1 text-sm text-slate-600"><%= experience.setup_intro %></p>
      </div>
      <%= link_to project_integration_docs_label(@project),
                  project_integration_docs_path(@project),
                  target: "_blank",
                  rel: "noopener noreferrer",
                  class: "btn-ghost inline-flex items-center gap-2" %>
    </div>

    <% setup_stages = {
      connect: ["Connect", "Create the credential boundary the client needs."],
      verify_delivery: ["Verify delivery", "Prove that one real receipt arrived with trustworthy app context."],
      improve_evidence: ["Improve evidence", "Add correlation and artifacts that make issues actionable."],
      external_sources: ["External sources", "Connect optional provider data without blending its freshness or denominator into SDK evidence."]
    } %>
    <div class="mt-5 space-y-5">
      <% setup_stages.each do |stage_key, (stage_label, stage_description)| %>
        <% steps = @setup_steps.select { |step| step.stage == stage_key } %>
        <% next if steps.empty? %>
        <section aria-labelledby="setup-stage-<%= stage_key %>">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 id="setup-stage-<%= stage_key %>" class="text-sm font-bold text-slate-900"><%= stage_label %></h3>
            <p class="text-xs text-slate-500"><%= stage_description %></p>
          </div>
          <div class="mt-2 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
            <% steps.each do |step| %>
              <% state_classes = {
                complete: "border-emerald-200 bg-emerald-50",
                partial: "border-amber-200 bg-amber-50",
                stale: "border-amber-200 bg-amber-50",
                blocked: "border-rose-200 bg-rose-50",
                failed: "border-rose-200 bg-rose-50",
                not_applicable: "border-slate-200 bg-slate-50",
                pending: "border-slate-200 bg-slate-50"
              } %>
              <article class="rounded-lg border <%= state_classes.fetch(step.state) %> p-4" data-setup-state="<%= step.state %>">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex min-w-0 items-center gap-2">
                    <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600">
                      <%= app_icon(step.icon, css: "h-3.5 w-3.5") %>
                    </span>
                    <strong class="text-sm font-semibold text-slate-900"><%= step.label %></strong>
                  </div>
                  <span class="text-[10px] font-bold uppercase tracking-wide text-slate-600"><%= step.state_label %></span>
                </div>
                <p class="mt-2 text-xs text-slate-600"><%= step.detail %></p>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  </section>

  <section class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <%= render "projects/setup_api_keys", tour_group: tour_group %>
    <%= render "projects/setup_ingest_endpoint", tour_group: tour_group %>
    <% if @self_monitoring_status.linked? %>
      <%= render "projects/setup_self_monitoring_guide", status: @self_monitoring_status, tour_group: tour_group %>
    <% else %>
      <%= render "projects/setup_integration_guide", tour_group: tour_group %>
    <% end %>
  </section>
</section>
<% end %>
