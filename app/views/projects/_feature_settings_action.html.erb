<%# locals: (label:, path:, description:, css: nil) %>

<%= link_to path,
            class: class_names("btn-ghost inline-flex h-10 shrink-0 items-center justify-center gap-1.5", css),
            title: description,
            data: { project_feature_settings: true } do %>
  <%= app_icon(:settings, css: "h-3.5 w-3.5 shrink-0") %>
  <span><%= label %></span>
<% end %>
