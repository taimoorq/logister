<% state_params = {
  filter: filter,
  q: query,
  assignee: local_assigns[:assignee].presence || "all",
  sort: local_assigns[:sort]
}.merge(local_assigns.fetch(:profile_filters, {})).compact_blank %>
<turbo-frame id="project_inbox"
             target="error_detail"
             style="view-transition-name: project-inbox; view-transition-class: project-inbox;">
  <span hidden data-inbox-state-url="<%= inbox_project_path(project, state_params) %>"></span>
  <% group_trends = local_assigns.fetch(:group_trends, {}) %>
  <% latest_events = local_assigns.fetch(:latest_events, {}) %>
  <% has_activity_events = local_assigns.fetch(:has_activity_events, false) %>
  <% assignee_param = local_assigns[:assignee].presence || "all" %>
  <% experience = project_experience(project) %>
  <% impact_summaries = local_assigns.fetch(:impact_summaries, {}) %>
  <% android_mapping_resolutions = local_assigns.fetch(:android_mapping_resolutions, {}) %>
  <% ios_symbol_coverages = local_assigns.fetch(:ios_symbol_coverages, {}) %>
  <% evidence_signals = local_assigns.fetch(:evidence_signals, {}) %>
  <% next_cursor = local_assigns[:next_cursor] %>
  <% active_sort = local_assigns[:sort].presence || experience.default_sort %>
  <header class="inbox-pane-header">
    <h2 class="text-sm font-semibold text-slate-900 uppercase tracking-[0.14em]"><%= experience.inbox_title %></h2>
    <p class="text-xs text-slate-500"><%= groups.size %> shown · <%= experience.sort_options.to_h.key(active_sort).to_s.downcase %></p>
  </header>
  <div class="inbox-table-wrap">
    <% if groups.any? %>
      <div class="inbox-list-scroll">
        <table class="inbox-table inbox-table-compact" aria-label="Error groups">
          <tbody>
            <% groups.each do |group| %>
              <% latest_event = latest_events[group.id] %>
              <% row_clickable = latest_event.present? %>
              <% row_impact = impact_summaries[group.id] %>
              <% first_seen_at = row_impact&.first_seen_at || group.first_seen_at %>
              <% last_seen_at = row_impact&.last_seen_at || group.last_seen_at %>
              <% row_occurrence_count = row_impact&.events || group.occurrence_count %>
              <% first_seen_words = time_ago_in_words(first_seen_at) %>
              <% last_seen_words = time_ago_in_words(last_seen_at) %>
              <% trend_points = group_trends.fetch(group.id) { group.trend } %>
              <% trend_total = trend_points.sum %>
              <% trend_window = local_assigns.fetch(:profile_filters, {}).to_h.stringify_keys["time_range"].presence || "7d" %>
              <% trend_window_label = { "24h" => "24 hour", "7d" => "7 day", "30d" => "30 day", "90d" => "90 day", "all" => "all-time" }.fetch(trend_window, "#{trend_points.size} day") %>
              <% trend_tooltip = "#{trend_window_label} trend: #{trend_points.join(", ")} occurrences. #{trend_total} total in this window." %>
              <% stage = group.stage.presence || "production" %>
              <% severity = group.severity.presence || "error" %>
              <% row_presenter = ProjectInbox::RowPresenter.new(project: project, group: group, event: latest_event, trend: trend_points, impact: row_impact, mapping_resolution: android_mapping_resolutions[latest_event&.id], symbol_coverage: ios_symbol_coverages[latest_event&.id], evidence_signal: evidence_signals[group.id]) %>
              <tr id="<%= dom_id(group) %>"
                  class="inbox-row<%= " is-clickable" if row_clickable %>"
                  data-action="<%= row_clickable ? 'click->inbox#openRow keydown.enter->inbox#openRowKey keydown.space->inbox#openRowKey' : '' %>"
                  tabindex="<%= row_clickable ? 0 : -1 %>"
                  aria-selected="<%= selected_uuid.present? && selected_uuid == group.uuid ? "true" : "false" %>"
                  aria-label="<%= row_clickable ? row_presenter.accessibility_label : nil %>"
                  style="view-transition-name: <%= dom_id(group) %>; view-transition-class: inbox-row;">
                <td class="inbox-error-cell">
                  <% if latest_event %>
                    <%= link_to partitioned_project_event_path(
                                  project,
                                  latest_event,
                                  state_params.merge(group_uuid: group.uuid)
                                ),
                                class: "error-row-link",
                                data: {
                                  turbo_frame: "error_detail",
                                  action: "click->inbox#openDetail",
                                  turbo_action: "advance"
                                } do %>
                      <% if row_presenter.mobile? %>
                        <span class="mobile-row-primary">
                          <span class="mobile-row-overline">
                            <% if row_presenter.attention_signal.present? %><strong class="mobile-row-attention" title="<%= row_presenter.attention_title %>"><%= row_presenter.attention_signal %></strong><% end %>
                            <% if row_presenter.attention_detail_label.present? %><span class="mobile-row-attention-context"><%= row_presenter.attention_detail_label %></span><% end %>
                            <span class="mobile-row-type"><%= row_presenter.failure_type_label %></span>
                            <% if row_presenter.fatality_label.present? %><span class="mobile-row-fatality"><%= row_presenter.fatality_label %></span><% end %>
                          </span>
                          <span class="mobile-row-headline"><%= row_presenter.headline %></span>
                          <% if row_presenter.supporting_label.present? %><span class="mobile-row-supporting"><%= row_presenter.supporting_label %></span><% end %>
                        </span>
                      <% else %>
                        <span class="error-row-primary">
                          <span class="error-title"><%= group.title %></span>
                          <% if group.subtitle.present? %>
                            <span class="error-subtitle"><%= group.subtitle %></span>
                          <% end %>
                        </span>
                      <% end %>
                    <% end %>
                  <% else %>
                    <span class="error-row-link error-row-link--orphan">
                      <span class="error-row-primary">
                        <span class="error-title"><%= group.title %></span>
                        <% if group.subtitle.present? %>
                          <span class="error-subtitle"><%= group.subtitle %></span>
                        <% end %>
                      </span>
                    </span>
                  <% end %>
                  <div class="error-meta-row">
                    <% if row_presenter.mobile? %>
                      <% if row_presenter.impact_label.present? %><span class="error-meta-chip" title="<%= row_presenter.impact_coverage_label %>"><strong><%= row_presenter.impact_label %></strong><% if row_presenter.impact_coverage_label.present? %><span class="sr-only">, <%= row_presenter.impact_coverage_label %></span><% end %></span><% end %>
                      <span class="error-meta-chip"><%= row_presenter.workflow_label %></span>
                      <% if row_presenter.evidence_quality_label.present? %><span class="error-meta-chip"><%= row_presenter.evidence_quality_label %></span><% end %>
                      <% if row_presenter.artifact_quality_label.present? %><span class="error-meta-chip"><%= row_presenter.artifact_quality_label %></span><% end %>
                    <% end %>
                    <span class="error-meta-chip"
                          title="<%= pluralize(row_occurrence_count, "event") %>"
                          aria-label="<%= pluralize(row_occurrence_count, "event") %>">
                      <%= app_icon(:info, css: "inbox-info-icon") %>
                      <strong><%= row_occurrence_count %></strong>
                    </span>
                    <% unless row_presenter.mobile? %><span class="error-meta-chip error-meta-trend"
                          title="<%= trend_tooltip %>"
                          aria-label="<%= trend_tooltip %>">
                      <%= app_icon(:info, css: "inbox-info-icon") %>
                      <span class="error-meta-sparkline"><%= render "shared/widgets/sparkline", points: trend_points, compact: true %></span>
                    </span><% end %>
                    <% unless row_presenter.mobile? %><span class="stage-tag stage-tag-compact"
                          title="Stage: <%= stage %>"
                          aria-label="Stage: <%= stage %>"><%= stage %></span>
                    <span class="severity-compact severity-<%= severity %>"
                          title="Severity: <%= severity %>"
                          aria-label="Severity: <%= severity %>">
                      <span class="severity-compact-dot" aria-hidden="true"></span>
                      <span><%= severity %></span>
                    </span><% end %>
                    <span class="error-meta-chip error-meta-assignee"
                          title="<%= group.assignee.present? ? "Assigned to #{inbox_assignee_label(project, current_user, group.assignee)}" : "Unassigned" %>"
                          aria-label="<%= group.assignee.present? ? "Assigned to #{inbox_assignee_label(project, current_user, group.assignee)}" : "Unassigned" %>">
                      <%= app_icon(:account, css: "inbox-info-icon") %>
                      <span><%= group.assignee.present? ? (group.assignee.name.presence || group.assignee.email) : "Unassigned" %></span>
                    </span>
                    <span class="error-meta-chip error-meta-time"
                          title="<%= row_presenter.mobile? ? row_presenter.recency_title : "First seen #{first_seen_words} ago. Last seen #{last_seen_words} ago." %>"
                          aria-label="<%= row_presenter.mobile? ? row_presenter.recency_label : "First seen #{first_seen_words} ago. Last seen #{last_seen_words} ago." %>">
                      <%= app_icon(:info, css: "inbox-info-icon") %>
                      <span><%= row_presenter.mobile? ? row_presenter.recency_label : "last #{last_seen_words} ago" %></span>
                    </span>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if next_cursor.present? %>
        <% next_page_params = {
          filter: filter,
          q: query,
          assignee: assignee_param,
          sort: local_assigns[:sort],
          cursor: next_cursor
        }.merge(local_assigns.fetch(:profile_filters, {})).compact_blank %>
        <nav class="inbox-pagination" aria-label="Issue pages">
          <%= link_to "Next #{ProjectInboxQuery::LIMIT} issues",
                      inbox_project_path(project, next_page_params),
                      class: "btn btn-ghost",
                      rel: "next",
                      data: { turbo_frame: "project_inbox", turbo_action: "advance" } %>
        </nav>
      <% end %>
    <% else %>
      <div class="inbox-empty">
        <p class="muted"><%= experience.inbox_empty_message %></p>
        <% if has_activity_events %>
          <p class="muted mt-2">
            This project has logs, metrics, transactions, or check-ins. Those live in
            <%= link_to "Events", activity_project_path(project), class: "inline-link", data: { turbo_frame: "_top" } %>.
          </p>
        <% end %>
        <% if query.present? %>
          <%= link_to "Clear search",
                      inbox_project_path(project, filter: filter, assignee: assignee_param),
                      class: "inline-link",
                      data: { turbo_frame: "project_inbox" } %>
        <% end %>
      </div>
    <% end %>
  </div>
</turbo-frame>
