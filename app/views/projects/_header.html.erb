<%# locals: (tour_group: nil, archived_notice_settings_link: true, highlight_header: false, highlight_navigation: false, page_key: nil) %>
<% highlight_header = local_assigns.fetch(:highlight_header, false) %>
<% highlight_navigation = local_assigns.fetch(:highlight_navigation, false) %>
<% page_context = project_page_context(@project, page_key: local_assigns[:page_key]) %>
<% section_label = page_context.page&.header_label || "Project" %>
<% header_data = {
  project_kind: page_context.integration_definition.key,
  project_experience: page_context.experience_definition.key,
  project_experience_version: page_context.experience_definition.version,
  project_page: page_context.page&.key
}.compact %>
<% header_data.merge!(product_tour_step_data(tour_group, :project_header)) if tour_group.present? && highlight_header %>

<header class="project-command-panel"
        <%= tag.attributes(data: header_data) %>>
  <div class="project-command-main">
    <div class="project-command-identity">
      <%= project_integration_icon(@project) %>
      <div class="min-w-0">
        <p class="dashboard-kicker"><%= section_label %></p>
        <h1><%= @project.name %></h1>
        <p>
          <code><%= @project.slug %></code>
          <span><%= @project.integration_label %></span>
          <span><%= @project.owned_by?(current_user) ? "Owner" : "Shared" %></span>
          <% if @project.archived? %>
            <span>Archived</span>
          <% end %>
        </p>
      </div>
    </div>

    <div class="project-command-actions">
      <%= render "projects/nav", page_context: page_context, tour_group: (highlight_navigation ? tour_group : nil) %>
      <%= tour_help_button if tour_group.present? %>
    </div>
  </div>
</header>

<%= render "projects/archived_notice",
           project: @project,
           show_settings_link: archived_notice_settings_link %>
