<% reporting = @app_store_connect_integration_setting.metadata.to_h["reporting"].to_h %>
<% import_error = @app_store_connect_integration_setting.metadata.to_h["last_error"].to_h %>
<% store_status = project_page_context(@project).capability_snapshot.status(:distribution_store) %>
<% store_badge = capability_status_badge(store_status) %>

<article class="settings-panel lg:col-span-2" id="app-store-connect-integration">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="dashboard-kicker">Apple distribution source</p>
      <h2 class="text-base font-bold text-slate-900 mb-2">App Store Connect</h2>
      <p class="text-slate-600 text-sm">Import Apple power and performance aggregates for the configured app every 15 minutes, with a manual sync available below. Store reports remain separate from SDK and MetricKit event counts because availability, delay, sampling, and denominators differ.</p>
    </div>
    <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold <%= store_badge[:classes] %>"><%= store_badge[:label] %></span>
  </div>
  <p class="mt-3 text-xs text-slate-600"><%= store_status.reason %></p>

  <%= form_with model: @app_store_connect_integration_setting,
                url: project_integration_setting_path(@project),
                method: :patch,
                data: setup_form_data,
                class: "mt-5 space-y-5" do |form| %>
    <%= setup_return_field %>
    <%= form.hidden_field :provider, value: ProjectIntegrationSetting::PROVIDERS[:app_store_connect] %>
    <label class="flex items-start gap-3">
      <%= form.check_box :enabled, class: "form-checkbox mt-1", disabled: !@integration_changes_allowed %>
      <span><span class="block text-sm font-semibold text-slate-900">Enable App Store Connect reporting</span><span class="block text-sm text-slate-600">Credentials stay in the host secret store; Logister saves references only.</span></span>
    </label>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div><%= form.label :external_project_id, "Bundle identifier", class: "form-label" %><%= form.text_field :external_project_id, placeholder: "com.acme.shop", class: "form-input", disabled: !@integration_changes_allowed %></div>
      <div><%= form.label :account_id, "Issuer ID", class: "form-label" %><%= form.text_field :account_id, placeholder: "69a6de7e-...", class: "form-input", disabled: !@integration_changes_allowed %></div>
      <div><%= form.label :external_project_name, "Key ID", class: "form-label" %><%= form.text_field :external_project_name, placeholder: "ABC123DEFG", class: "form-input", disabled: !@integration_changes_allowed %></div>
      <div><%= form.label :credential_reference, "Private-key environment variable", class: "form-label" %><%= form.text_field :credential_reference, placeholder: "APP_STORE_CONNECT_PRIVATE_KEY", class: "form-input", disabled: !@integration_changes_allowed %><p class="mt-1 text-xs text-slate-500">Store the <code>.p8</code> contents in this environment variable. Never paste the key into Logister.</p></div>
    </div>
    <% if @integration_changes_allowed %><div class="flex justify-end"><%= form.submit "Save App Store Connect settings", class: "btn btn-primary" %></div><% end %>
  <% end %>

  <div class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-4" aria-label="App Store Connect sync health">
    <div class="rounded-lg border border-slate-200 bg-slate-50 p-3"><span class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Source</span><strong class="mt-1 block text-sm text-slate-900">Store aggregate</strong></div>
    <div class="rounded-lg border border-slate-200 bg-slate-50 p-3"><span class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Last success</span><strong class="mt-1 block text-sm text-slate-900"><%= @app_store_connect_integration_setting.last_imported_at? ? local_time_tag(@app_store_connect_integration_setting.last_imported_at, format: :long) : "Never" %></strong></div>
    <div class="rounded-lg border border-slate-200 bg-slate-50 p-3"><span class="block text-xs font-semibold uppercase tracking-wide text-slate-500">App</span><strong class="mt-1 block text-sm text-slate-900"><%= reporting.dig("app", "name").presence || reporting.dig("app", "bundle_id").presence || "Not resolved" %></strong></div>
    <div class="rounded-lg border border-slate-200 bg-slate-50 p-3"><span class="block text-xs font-semibold uppercase tracking-wide text-slate-500">Report</span><strong class="mt-1 block text-sm text-slate-900"><%= reporting["metrics"].present? ? "Available" : "No metrics imported" %></strong></div>
  </div>

  <% if import_error.present? %>
    <div class="mt-4 rounded-lg border border-red-200 bg-red-50 p-4" role="alert"><strong class="block text-sm text-red-800">Last sync failed</strong><p class="mt-1 text-sm text-red-800"><%= import_error["message"] %></p></div>
  <% elsif reporting.present? %>
    <div class="mt-4 rounded-lg border border-blue-200 bg-blue-50 p-4"><strong class="block text-sm text-blue-900">Freshness and provenance</strong><p class="mt-1 text-sm text-blue-900"><%= reporting["freshness_note"] %> These values are not added to SDK events or crash-free metrics.</p></div>
  <% else %>
    <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-4"><strong class="block text-sm text-slate-900">No App Store metrics imported</strong><p class="mt-1 text-sm text-slate-600">Save valid credentials, then run the first sync. Apple may return no report until the app has sufficient opted-in production usage.</p></div>
  <% end %>

  <% if @integration_changes_allowed && @app_store_connect_integration_setting.persisted? %>
    <div class="mt-4 flex justify-end">
      <%= button_to "Sync App Store metrics",
                    project_integration_setting_import_path(@project, provider: "app_store_connect"),
                    method: :post,
                    params: { setup_return: @setup_return },
                    form: { data: setup_form_data },
                    class: "btn btn-ghost",
                    disabled: !@app_store_connect_integration_setting.configured? %>
    </div>
  <% end %>
</article>
