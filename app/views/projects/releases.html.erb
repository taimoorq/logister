<%= render "projects/header" %>

<section class="space-y-6" aria-labelledby="mobile-releases-title">
  <div class="dashboard-panel">
    <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
      <div>
        <p class="dashboard-kicker">Releases</p>
        <h2 id="mobile-releases-title" class="text-xl font-bold text-slate-900">Observed app builds</h2>
        <p class="mt-1 max-w-3xl text-sm text-slate-600">
          Stability evidence grouped by the version, build, and channel sent by the app. Receipt time drives recency; source occurrence time is shown only when its precision is known.
        </p>
      </div>
      <%= link_to "Integration health", settings_project_path(@project, section: "integrations"), class: "btn-ghost" %>
    </div>
  </div>

  <section class="grid grid-cols-1 gap-4 lg:grid-cols-2" aria-label="Mobile release evidence health">
    <article class="dashboard-panel">
      <p class="dashboard-kicker">External aggregate</p>
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-base font-bold text-slate-900"><%= @distribution_snapshot.label %></h3>
        <span class="text-xs font-bold uppercase text-slate-500"><%= @distribution_snapshot.status.state.to_s.humanize %></span>
      </div>
      <p class="mt-2 text-sm text-slate-600"><%= @distribution_snapshot.status.reason %></p>
      <% if @distribution_snapshot.fetched_at %>
        <p class="mt-2 text-xs text-slate-500">Fetched <%= time_ago_in_words(@distribution_snapshot.fetched_at) %> ago<% if @distribution_snapshot.report_start && @distribution_snapshot.report_end %>; source window <%= l(@distribution_snapshot.report_start, format: :long) %>–<%= l(@distribution_snapshot.report_end, format: :long) %><% end %>.</p>
        <p class="mt-1 text-xs text-slate-500"><%= pluralize(@distribution_snapshot.release_count, "serving release") %> · <%= pluralize(@distribution_snapshot.metric_row_count, "aggregate metric row") %></p>
      <% end %>
      <% if @distribution_snapshot.last_error %><p class="mt-2 text-xs font-semibold text-rose-700">Latest import error: <%= @distribution_snapshot.last_error %></p><% end %>
      <p class="mt-3 text-xs text-slate-500"><%= @distribution_snapshot.population_note %> It is never merged into the SDK installation or session denominator.</p>
    </article>

    <% artifact_status = @capability_snapshot.status(@project.integration_android? ? :stack_mapping : :symbol_artifacts) %>
    <article class="dashboard-panel">
      <p class="dashboard-kicker">Build artifacts</p>
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-base font-bold text-slate-900"><%= @project.integration_android? ? "R8 mapping coverage" : "dSYM UUID coverage" %></h3>
        <span class="text-xs font-bold uppercase text-slate-500"><%= artifact_status.state.to_s.humanize %></span>
      </div>
      <p class="mt-2 text-sm text-slate-600"><%= artifact_status.reason %></p>
      <p class="mt-3 text-xs text-slate-500"><%= @project.integration_android? ? "A build match does not claim that every frame was retraced." : "UUID verification and frame symbolication are separate server-owned states." %></p>
      <%= link_to "Open artifacts", artifacts_project_path(@project), class: "btn-ghost mt-4 inline-flex" %>
    </article>
  </section>

  <% if @release_index.releases.empty? %>
    <section class="dashboard-panel" aria-label="No observed mobile builds">
      <h3 class="text-base font-bold text-slate-900">No build evidence received yet</h3>
      <p class="mt-2 text-sm text-slate-600">Send a real diagnostic with app version and build metadata. A row with unknown build data will remain visible rather than being assigned to the current uploader build.</p>
      <%= link_to "Open setup", setup_project_path(@project), class: "btn-primary mt-4 inline-flex" %>
    </section>
  <% else %>
    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white" aria-label="Observed mobile releases">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[62rem] text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-4 py-3">Build</th>
              <th class="px-4 py-3">Channel</th>
              <th class="px-4 py-3">Issues</th>
              <th class="px-4 py-3">Impact evidence</th>
              <th class="px-4 py-3">Artifacts</th>
              <th class="px-4 py-3">Latest receipt</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <% @release_index.releases.each do |release| %>
              <tr>
                <td class="px-4 py-4 align-top">
                  <strong class="block text-slate-900"><%= release.label %></strong>
                  <span class="mt-1 block text-xs text-slate-500"><%= release.platform.presence || @project.integration_label %></span>
                </td>
                <td class="px-4 py-4 align-top text-slate-700"><%= release.channel_label %></td>
                <td class="px-4 py-4 align-top">
                  <strong class="block text-slate-900"><%= pluralize(release.issue_count, "issue") %></strong>
                  <span class="text-xs text-slate-500"><%= pluralize(release.occurrence_count, "diagnostic") %></span>
                </td>
                <td class="px-4 py-4 align-top">
                  <strong class="block text-slate-900"><%= number_with_delimiter(release.affected_installations) %> installations</strong>
                  <span class="text-xs text-slate-500"><%= release.identity_coverage.to_s.humanize %> identity coverage</span>
                </td>
                <td class="px-4 py-4 align-top text-slate-700"><%= release.artifact_state.to_s.humanize %></td>
                <td class="px-4 py-4 align-top">
                  <time class="block font-semibold text-slate-900" datetime="<%= release.last_received_at&.iso8601 %>"><%= time_ago_in_words(release.last_received_at) %> ago</time>
                  <span class="text-xs text-slate-500"><%= release.sources.presence&.join(", ") || "Source not labelled" %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <nav class="flex items-center justify-between" aria-label="Release pages">
      <% if @release_page > 1 %>
        <%= link_to "Previous", releases_project_path(@project, page: @release_page - 1), class: "btn-ghost" %>
      <% else %>
        <span></span>
      <% end %>
      <% if @release_index.has_more %>
        <%= link_to "Next", releases_project_path(@project, page: @release_page + 1), class: "btn-ghost" %>
      <% end %>
    </nav>
  <% end %>
</section>
