<% tour_group = "project-errors" %>
<% experience = project_experience(@project) %>

<%= render layout: "shared/product_tour_frame", locals: { tour_group: tour_group } do %>

<%= render "projects/header", tour_group: tour_group %>

<div class="inbox-workbench min-w-0"
     data-controller="inbox"
     data-project-integration="<%= @project.integration_kind %>"
     data-project-experience="<%= experience.key %>"
     data-project-experience-version="<%= experience.version %>"
     data-inbox-project-uuid-value="<%= @project.uuid %>"
     data-action="turbo:frame-load@document->inbox#onFrameLoaded turbo:before-fetch-request@document->inbox#onBeforeFetch turbo:fetch-request-error@document->inbox#onFetchError turbo:frame-missing@document->inbox#onFetchError turbo:submit-start@document->inbox#onSubmitStart turbo:submit-end@document->inbox#onSubmitEnd">
  <section class="inbox-workbench-filters"
           aria-label="Inbox filters"
           <%= tag.attributes(data: product_tour_step_data(tour_group, :filters)) %>>
    <div class="inbox-filter-bar">
      <%= form_with url: inbox_project_path(@project), method: :get,
                    class: "inbox-filter-search",
                    data: { turbo_frame: "project_inbox", turbo_action: "advance", inbox_target: "searchForm", action: "submit->inbox#onSearchSubmit" } do |f| %>
        <%= f.hidden_field :filter, value: @filter, data: { inbox_target: "filterField" } %>
        <%= f.hidden_field :assignee, value: @assignee_filter, data: { inbox_target: "assigneeField" } %>
        <%= f.hidden_field :sort, value: @sort %>
        <%= profile_filter_hidden_fields(f, @profile_filters) %>
        <%= f.label :q, "Search inbox", class: "kicker inbox-filter-search-label" %>
        <%= f.search_field :q, value: @query, placeholder: experience.search_placeholder,
                           class: "form-input inbox-filter-search-input",
                           data: { action: "input->inbox#debouncedSearch", inbox_target: "searchInput" } %>
      <% end %>

      <%= form_with url: inbox_project_path(@project), method: :get,
                    class: "inbox-assignee-filter",
                    data: { turbo_frame: "project_inbox", turbo_action: "advance", inbox_target: "assigneeForm" } do |f| %>
        <%= f.hidden_field :filter, value: @filter %>
        <%= f.hidden_field :q, value: @query %>
        <%= f.hidden_field :sort, value: @sort %>
        <%= profile_filter_hidden_fields(f, @profile_filters) %>
        <%= f.label :assignee, "Assignee", class: "kicker inbox-filter-search-label" %>
        <%= f.select :assignee,
                     inbox_assignee_options(@project, current_user, @assignable_users),
                     { selected: @assignee_filter },
                     class: "form-input inbox-assignee-select",
                     data: { action: "change->inbox#submitAssigneeFilter" } %>
      <% end %>

      <% if experience.supports?(:mobile) %>
        <%= form_with url: inbox_project_path(@project), method: :get,
                      class: "mobile-inbox-controls",
                      data: { turbo_frame: "project_inbox", turbo_action: "advance" } do |f| %>
          <%= f.hidden_field :filter, value: @filter %>
          <%= f.hidden_field :q, value: @query %>
          <%= f.hidden_field :assignee, value: @assignee_filter %>

          <label class="mobile-control-field">
            <span>Release</span>
            <%= f.select :release,
                         [["All releases", ""], *@profile_filter_options.fetch("release", []).map { |release| [release, release] }],
                         { selected: @profile_filters["release"] },
                         class: "form-input",
                         data: { action: "change->inbox#submitForm" } %>
          </label>

          <label class="mobile-control-field">
            <span>Sort</span>
            <%= f.select :sort, experience.sort_options, { selected: @sort }, class: "form-input", data: { action: "change->inbox#submitForm" } %>
          </label>

          <details class="mobile-filter-drawer">
            <summary>Filters <span><%= @profile_filters.except("release").size %></span></summary>
            <div class="mobile-filter-grid">
              <%= render partial: "projects/mobile_filter_field",
                         collection: experience.filters.reject { |definition| definition.key == :release },
                         as: :definition,
                         locals: { form: f, profile_filter_options: @profile_filter_options, profile_filters: @profile_filters } %>
              <div class="mobile-filter-actions">
                <%= f.submit "Apply filters", class: "btn btn-primary" %>
                <%= link_to "Clear mobile filters",
                            inbox_project_path(@project, filter: @filter, q: @query, assignee: @assignee_filter, sort: @sort),
                            class: "inline-link",
                            data: {
                              turbo_frame: "project_inbox",
                              turbo_action: "advance",
                              inbox_target: "clearProfileLink",
                              inbox_profile_filter_keys: experience.filters.map(&:key).join(",")
                            } %>
              </div>
            </div>
          </details>
        <% end %>
      <% end %>

      <%= render "inbox_counts", project: @project, counts: @counts, filter: @filter, query: @query, assignee: @assignee_filter %>

      <%= link_to "All projects", project_collection_path(@project), class: "inbox-filter-projects-link" %>
      <%= render "projects/feature_settings_action",
                 label: "Inbox notifications",
                 path: settings_project_path(@project, section: "notifications", notification_path: "errors", anchor: "error-triage-alerts"),
                 description: "Configure error triage notifications",
                 css: "md:ml-auto" %>
    </div>
  </section>

  <section class="inbox-workbench-list"
           data-inbox-target="listPane"
           aria-busy="false"
           <%= tag.attributes(data: product_tour_step_data(tour_group, :groups)) %>>
    <%= render "inbox_table",
               project:       @project,
               groups:        @groups,
               latest_events: @latest_events,
               android_mapping_resolutions: @android_mapping_resolutions,
               ios_symbol_coverages: @ios_symbol_coverages,
               group_trends:  @group_trends,
               impact_summaries: @impact_summaries,
               evidence_signals: @evidence_signals,
               has_activity_events: @has_activity_events,
               selected_uuid: @selected_group&.uuid,
               filter:        @filter,
               query:         @query,
               assignee:      @assignee_filter,
               sort:          @sort,
               profile_filters: @profile_filters,
               next_cursor:   @next_cursor %>
  </section>

  <section class="inbox-workbench-detail"
           data-inbox-target="detailPane"
           aria-busy="false"
           <%= tag.attributes(data: product_tour_step_data(tour_group, :detail)) %>>
    <% if @detail_event.present? %>
      <%= render "project_events/event_detail",
                 project:     @project,
                 event:       @detail_event,
                 group:       @detail_group,
                 occurrences: @detail_occurrences,
                 related_logs: @detail_related_logs,
                 impact_summary: @detail_impact_summary,
                 variant_summary: @detail_variant_summary,
                 filter:      @filter,
                 assignee:    @assignee_filter,
                 assignable_users: @assignable_users,
                 query:       @query,
                 tab:         @tab,
                 frame_scope: params[:frame_scope],
                 frame:       params[:frame] %>
    <% else %>
      <%= render "empty_detail" %>
    <% end %>
  </section>
<% end %>
</div>
