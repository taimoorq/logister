<%# locals: (page_context:, tour_group: nil) %>
<% navigation = page_context.navigation %>

<nav class="project-tabs"
     aria-label="Project sections"
     <%= tag.attributes(data: product_tour_step_data(tour_group, :project_navigation)) if tour_group.present? %>>
  <% navigation.tabs.each do |tab| %>
    <% current = navigation.current?(tab) %>
    <%= link_to page_context.path_for(tab.entry_page),
                title: tab.entry_page.description,
                class: class_names("project-tab", "project-tab-pinned": tab.pinned?),
                aria: { current: ("page" if current) } do %>
      <%= app_icon(tab.icon_key, css: "h-4 w-4 shrink-0") %>
      <span><%= tab.label %></span>
    <% end %>
  <% end %>
</nav>

<% if navigation.views.any? %>
  <nav class="project-subnav" aria-label="<%= navigation.current_section_label %> views">
    <% navigation.views.each do |view| %>
      <% view_path, dropped = project_view_link(page_context, view) %>
      <%= link_to view_path,
                  title: view.description,
                  class: "project-subnav-link",
                  aria: { current: ("page" if navigation.view_current?(view)) } do %>
        <%= view.view_label %>
        <% if dropped.any? %><span class="sr-only">. <%= dropped.to_sentence.tr("_", " ") %> does not carry over to this view.</span><% end %>
      <% end %>
    <% end %>
  </nav>
<% end %>
