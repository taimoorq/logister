<% play_status = project_page_context(@project).capability_snapshot.status(:distribution_store) %>
<% play_badge = capability_status_badge(play_status) %>
<article class="settings-panel lg:col-span-2" id="google-play-integration">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="dashboard-kicker">Android distribution</p>
      <h2 class="text-base font-bold text-slate-900 mb-2">Google Play Developer Reporting</h2>
      <p class="text-slate-600 text-sm">Import Play release options, crash/ANR rates, and anomalies. Play metrics remain separate from Logister SDK impact because their populations and freshness differ.</p>
    </div>
    <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold <%= play_badge[:classes] %>"><%= play_badge[:label] %></span>
  </div>
  <p class="mt-3 text-xs text-slate-600"><%= play_status.reason %></p>

  <%= form_with model: @google_play_integration_setting,
                url: project_integration_setting_path(@project),
                method: :patch,
                data: setup_form_data,
                class: "mt-5 space-y-5" do |form| %>
    <%= setup_return_field %>
    <%= form.hidden_field :provider, value: ProjectIntegrationSetting::PROVIDERS[:google_play] %>

    <label class="flex items-start gap-3">
      <%= form.check_box :enabled, class: "form-checkbox mt-1", disabled: !@integration_changes_allowed %>
      <span>
        <span class="block text-sm font-semibold text-slate-900">Enable Google Play imports</span>
        <span class="block text-sm text-slate-600">Requires the Play Developer Reporting API and read-only app access.</span>
      </span>
    </label>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div>
        <%= form.label :external_project_id, "Android package name", class: "form-label" %>
        <%= form.text_field :external_project_id, placeholder: "com.acme.shop", class: "form-input", disabled: !@integration_changes_allowed %>
      </div>
      <div>
        <%= form.label :credential_reference, "Credential environment variable", class: "form-label" %>
        <%= form.text_field :credential_reference, placeholder: "GOOGLE_PLAY_REPORTING_CREDENTIALS", class: "form-input", disabled: !@integration_changes_allowed %>
        <p class="mt-1 text-xs text-slate-500">Store service-account JSON or a short-lived OAuth token in the environment variable. Never paste the secret here.</p>
      </div>
    </div>

    <fieldset>
      <legend class="form-label">Permitted release tracks</legend>
      <div class="mt-2 flex flex-wrap gap-4">
        <% %w[internal closed open production].each do |track| %>
          <label class="inline-flex items-center gap-2 text-sm text-slate-700">
            <%= check_box_tag "project_integration_setting[metadata][track_allowlist][]",
                              track,
                              Array(@google_play_integration_setting.metadata["track_allowlist"]).include?(track),
                              disabled: !@integration_changes_allowed,
                              class: "form-checkbox" %>
            <span><%= track.humanize %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <% if @integration_changes_allowed %>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-xs text-slate-500">Last imported: <strong><%= @google_play_integration_setting.last_imported_at ? local_time_tag(@google_play_integration_setting.last_imported_at, format: :long) : "Never" %></strong></p>
        <%= form.submit "Save Google Play settings", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>

  <% if @integration_changes_allowed %>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-slate-200 bg-slate-50 p-4">
      <div>
        <strong class="block text-sm text-slate-900">Play reporting import</strong>
        <% if (last_error = @google_play_integration_setting.metadata["last_error"]).present? %>
          <span class="text-sm text-red-700">Last failure: <%= last_error["message"] %></span>
        <% elsif @google_play_integration_setting.last_imported_at %>
          <span class="text-sm text-slate-600">Latest 28-day snapshot is stored with Google Play provenance and America/Los_Angeles reporting dates.</span>
        <% else %>
          <span class="text-sm text-slate-600">No external metrics have been imported.</span>
        <% end %>
      </div>
      <%= button_to "Import now", project_integration_setting_import_path(@project), method: :post, params: { setup_return: @setup_return }, form: { data: setup_form_data }, class: "btn btn-ghost", disabled: !@google_play_integration_setting.persisted? || !@google_play_integration_setting.configured? %>
    </div>
  <% end %>

  <% if (reporting = @google_play_integration_setting.metadata["reporting"]).present? %>
    <% window = reporting.fetch("window", {}) %>
    <% release_tracks = Array(reporting.dig("release_filter_options", "tracks")) %>
    <% serving_releases_count = release_tracks.sum { |track| Array(track["servingReleases"]).size } %>
    <section class="mt-4 rounded-lg border border-blue-200 bg-blue-50 p-4" aria-label="Imported Google Play metrics">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <strong class="block text-sm text-slate-900">Google Play snapshot</strong>
          <span class="text-xs text-slate-600"><%= [window["start"], window["end"]].compact.join(" to ") %> · <%= window["time_zone"] %> · fetched <%= reporting["fetched_at"] %></span>
        </div>
        <a href="https://play.google.com/console" target="_blank" rel="noopener noreferrer" class="inline-link text-sm">Open Play Console</a>
      </div>
      <dl class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div><dt class="text-xs text-slate-600">Crash-rate rows</dt><dd class="text-lg font-bold text-slate-900"><%= Array(reporting.dig("crash_rates", "rows")).size %></dd></div>
        <div><dt class="text-xs text-slate-600">ANR-rate rows</dt><dd class="text-lg font-bold text-slate-900"><%= Array(reporting.dig("anr_rates", "rows")).size %></dd></div>
        <div><dt class="text-xs text-slate-600">Anomalies</dt><dd class="text-lg font-bold text-slate-900"><%= Array(reporting.dig("anomalies", "anomalies")).size %></dd></div>
        <div><dt class="text-xs text-slate-600">Tracks / releases</dt><dd class="text-lg font-bold text-slate-900"><%= release_tracks.size %> / <%= serving_releases_count %></dd></div>
      </dl>
      <p class="mt-3 text-xs text-slate-600">Source: Google Play Developer Reporting API. These rows are not added to Logister SDK event, installation, or session counts.</p>
    </section>
  <% end %>
</article>
