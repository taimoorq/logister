<%= render "projects/header" unless turbo_frame_request? %>
<%= turbo_frame_tag "related_requests" do %>
  <section class="connection-evidence card" aria-labelledby="related-requests-title">
    <header class="connection-evidence-header">
      <h2 id="related-requests-title">Related requests</h2>
      <p>Follow this occurrence across accessible connected projects.</p>
    </header>
    <% if @error %>
      <p role="alert"><%= @error %></p>
    <% else %>
      <div class="connection-evidence-summary">
        <strong><%= correlation_request_summary(@result, @project) %></strong>
        <p>Matching identifiers show related activity, not proof of cause. Client and server durations are separate measurements.</p>
        <p><%= local_time_tag(Time.iso8601(@result[:from]), format: :long) %> – <%= local_time_tag(Time.iso8601(@result[:to]), format: :long) %></p>
      </div>
      <% if @result[:partial] %><p role="status">Results are incomplete. Some data is outside retention or the result limit was reached. Narrow the time range to investigate further.</p><% end %>
      <% if @result[:items].empty? %><p><%= @result[:reason] || "No related requests found in the accessible connected projects for this time range." %></p><% end %>
      <% if @result[:anchor] %>
        <details><summary>Selected occurrence</summary><%= render "project_correlations/record", item: @result[:anchor] %></details>
      <% end %>
      <% @result[:items].each do |item| %>
        <%= render "project_correlations/record", item: %>
      <% end %>
    <% end %>
    <% if @event %>
    <details class="connection-evidence-range" <%= "open" if @error %>>
      <summary>Change investigation window</summary>
      <%= form_with url: @correlation_path || correlations_project_event_path(@project, @event), method: :get, class: "connection-evidence-facts" do |form| %>
        <% if @correlation_path %>
          <%= form.hidden_field :occurred_at, value: @event.occurred_at.iso8601(6) %>
          <%= form.hidden_field :environment, value: @event.context["environment"] %>
        <% end %>
        <div><%= form.label :from, "From (ISO 8601)" %><%= form.text_field :from, value: params[:from] || @result&.dig(:from), required: true, class: "form-input" %></div>
        <div><%= form.label :to, "To (ISO 8601)" %><%= form.text_field :to, value: params[:to] || @result&.dig(:to), required: true, class: "form-input" %></div>
        <%= form.submit "Update time range", class: "btn-primary" %>
      <% end %>
    </details>
    <% end %>
  </section>
<% end %>
