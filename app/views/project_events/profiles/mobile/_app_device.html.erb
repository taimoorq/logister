<% presenter = event_presenter(project, event, exception_data) %>
<% sections = {
  "App & release" => presenter.app_details,
  "Device" => presenter.device_details,
  "Operating system" => presenter.os_details,
  "Correlation & completeness" => presenter.correlation_details
} %>
<% if experience.key == :ios %>
  <% sections["Diagnostic source"] = presenter.diagnostic_details.merge(symbol_coverage: ios_symbol_coverage(project, event, exception_data).label) %>
  <% sections["Termination"] = presenter.termination_details if presenter.termination_details.any? %>
<% end %>

<div class="mobile-context-grid">
  <% sections.each do |title, details| %>
    <section class="mobile-context-section">
      <h3><%= title %></h3>
      <% if details.any? %>
        <dl>
          <% details.each do |key, value| %>
            <div>
              <dt><%= key.to_s.humanize %></dt>
              <dd><code><%= value.to_s %></code></dd>
            </div>
          <% end %>
        </dl>
      <% else %>
        <p class="muted">Not captured for this occurrence.</p>
      <% end %>
    </section>
  <% end %>
</div>

<% variant_summary = local_assigns[:variant_summary] %>
<% if variant_summary&.available? %>
  <section class="mobile-context-section mt-4" aria-labelledby="mobile-variants-title">
    <h3 id="mobile-variants-title">App call-path variants</h3>
    <p class="muted"><%= variant_summary.classified_events %> of <%= variant_summary.total_events %> scoped events have a stable raw app-frame path. Variants do not change issue grouping.</p>
    <ol class="mobile-variant-list">
      <% variant_summary.variants.each_with_index do |variant, index| %>
        <li>
          <div><strong>Variant <%= index + 1 %></strong><span><%= number_to_percentage(variant.share * 100, precision: 0) %> of classified events</span></div>
          <code><%= variant.label %></code>
          <span><%= pluralize(variant.events, "event") %> · last observed <%= time_ago_in_words(variant.last_seen_at) %> ago</span>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>

<% if experience.supports?(:mobile) %>
  <% missing = [] %>
  <% missing << "Sessions are not collected, so affected-session and crash-free-session metrics are unavailable." if presenter.correlation_details[:session].blank? %>
  <% missing << "Installation identity is not collected, so affected-installation metrics are unavailable." if presenter.correlation_details[:installation].blank? %>
  <% missing << "No breadcrumbs were captured for this occurrence." if presenter.respond_to?(:breadcrumbs) && presenter.breadcrumbs.empty? %>
  <% if missing.any? %>
    <section class="mobile-context-section mt-4" aria-labelledby="telemetry-completeness-title">
      <h3 id="telemetry-completeness-title">Telemetry completeness</h3>
      <ul class="list-disc space-y-1 pl-5 text-sm text-slate-600">
        <% missing.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </section>
  <% end %>
<% end %>
