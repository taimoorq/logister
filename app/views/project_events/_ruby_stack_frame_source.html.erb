<% exception_data = local_assigns[:exception_data] || event_exception_data(event) %>
<% backtrace = local_assigns[:backtrace] || event_backtrace(exception_data) %>
<% parsed_frames = parse_backtrace_frames(backtrace) %>
<% app_frames = parsed_frames.select { |frame| frame[:application_frame] } %>
<% frame_scope = local_assigns[:frame_scope].presence_in(%w[application all]) || "application" %>
<% visible_frames = local_assigns[:visible_frames] || ((frame_scope == "application" && app_frames.any?) ? app_frames : parsed_frames) %>
<% selected_frame_index = local_assigns[:selected_frame_index].to_i %>
<% selected_frame_index = 0 if selected_frame_index.negative? || selected_frame_index >= visible_frames.size %>
<% selected_frame = local_assigns.key?(:selected_frame) ? local_assigns[:selected_frame] : visible_frames[selected_frame_index] %>
<% source_lookup = if local_assigns.key?(:source_lookup)
  local_assigns[:source_lookup]
else
  source_resolution_for_event_frame(project, event, selected_frame)
end %>
<% source_excerpt = if local_assigns.key?(:source_excerpt)
  local_assigns[:source_excerpt]
else
  source_excerpt_for_event_frame(project, event, selected_frame)
end %>
<% filter_param = local_assigns[:filter_param].presence || "unresolved" %>
<% query_param = local_assigns[:query_param].to_s %>
<% assignee_param = local_assigns[:assignee_param].presence || "all" %>

<turbo-frame id="stack_frame_source"
             class="better-errors-source-frame"
             data-stacktrace-target="sourceFrame"
             aria-busy="false">
  <% if source_excerpt.blank? && source_lookup&.diagnostics&.dig(:message).present? %>
    <%= render "project_events/source_lookup_status", source_lookup: source_lookup %>
  <% end %>

  <section class="better-errors-code card">
    <% if source_excerpt.present? %>
      <%= render "project_events/source_excerpt",
                 source_excerpt: source_excerpt,
                 project: project,
                 event: event,
                 group: group,
                 filter_param: filter_param,
                 query_param: query_param,
                 assignee_param: assignee_param,
                 active_tab: "stacktrace",
                 frame_scope: frame_scope,
                 selected_frame_index: selected_frame_index %>
    <% elsif selected_frame.present? %>
      <div class="better-errors-code-header">
        <span><%= selected_frame[:file] %></span>
        <% if selected_frame[:line_number].present? %>
          <span class="better-errors-code-location">Line <%= selected_frame[:line_number] %></span>
        <% end %>
      </div>
      <div class="copy-block copy-block-tight" data-controller="copy" data-copy-text-value="<%= selected_frame[:raw] %>">
        <button type="button" class="copy-block-btn" data-action="copy#copy" aria-label="Copy stack frame">
          <%= app_icon(:clipboard, css: "w-3.5 h-3.5") %>
          <span data-copy-target="buttonLabel">Copy</span>
        </button>
        <pre class="stacktrace" data-copy-target="source"><code><%= selected_frame[:raw] %></code></pre>
      </div>
    <% else %>
      <% fallback_stacktrace = Array(backtrace).presence&.join("\n") || event.message %>
      <div class="copy-block copy-block-tight" data-controller="copy" data-copy-text-value="<%= fallback_stacktrace %>">
        <button type="button" class="copy-block-btn" data-action="copy#copy" aria-label="Copy stacktrace">
          <%= app_icon(:clipboard, css: "w-3.5 h-3.5") %>
          <span data-copy-target="buttonLabel">Copy</span>
        </button>
        <pre class="stacktrace" data-copy-target="source"><code><%= fallback_stacktrace %></code></pre>
      </div>
    <% end %>
  </section>
</turbo-frame>
