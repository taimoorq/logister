<div class="better-errors-shell"
     data-controller="stacktrace"
     data-action="turbo:before-fetch-request@document->stacktrace#onBeforeFetch turbo:frame-load@document->stacktrace#onFrameLoad">
  <% assignee_param = local_assigns[:assignee_param].presence || "all" %>
  <header class="better-errors-header">
    <p class="better-errors-runtime">
      <span class="better-errors-runtime-kind">Ruby</span>
      <strong><%= exception_data.is_a?(Hash) ? (exception_data["class"] || exception_data[:class] || "RuntimeError") : "RuntimeError" %></strong>
      <span>in <%= request_details[:rails_action].presence || "unknown#action" %></span>
    </p>
    <%= render "project_events/request_highlight",
               http_method: request_details[:http_method],
               target: request_highlight_target(request_details[:url], request_details[:path], query_string: request_details[:query_string]),
               route: request_details[:rails_action] %>
  </header>

  <div class="better-errors-workbench">
    <aside class="better-errors-frames">
      <div class="better-errors-frame-scope">
        <%= link_to "Application Frames",
                    partitioned_project_event_path(project, event, filter: filter_param, q: query_param, assignee: assignee_param, group_uuid: group&.uuid, tab: "stacktrace", frame_scope: "application", frame: 0),
                    class: "frame-scope-pill #{'is-active' if frame_scope == 'application'}",
                    data: { turbo_frame: "error_detail" } %>
        <%= link_to "All Frames",
                    partitioned_project_event_path(project, event, filter: filter_param, q: query_param, assignee: assignee_param, group_uuid: group&.uuid, tab: "stacktrace", frame_scope: "all", frame: 0),
                    class: "frame-scope-pill #{'is-active' if frame_scope == 'all'}",
                    data: { turbo_frame: "error_detail" } %>
      </div>

      <% if visible_frames.any? %>
        <ol class="frame-list">
          <% visible_frames.each_with_index do |frame_data, index| %>
            <% frame_label = frame_data[:method_name].presence || "unknown" %>
            <li class="frame-item <%= "is-active" if index == selected_frame_index %>">
              <%= link_to partitioned_project_event_path(project, event, filter: filter_param, q: query_param, assignee: assignee_param, group_uuid: group&.uuid, tab: "stacktrace", frame_scope: frame_scope, frame: index),
                          class: "frame-link",
                          aria: { current: ("true" if index == selected_frame_index) },
                          data: {
                            turbo_frame: "stack_frame_source",
                            action: "click->stacktrace#selectFrame",
                            stacktrace_target: "frame"
                          } do %>
                <span class="frame-method"><%= frame_label %></span>
                <span class="frame-file"><%= frame_data[:file] %>, line <%= frame_data[:line_number] %></span>
              <% end %>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="muted">No stack frames were captured for this event.</p>
      <% end %>
    </aside>

    <div class="better-errors-main">
      <%= render "project_events/ruby_stack_frame_source",
                 project: project,
                 event: event,
                 group: group,
                 exception_data: exception_data,
                 filter_param: filter_param,
                 query_param: query_param,
                 assignee_param: assignee_param,
                 source_excerpt: source_excerpt,
                 source_lookup: local_assigns[:source_lookup],
                 frame_scope: frame_scope,
                 visible_frames: visible_frames,
                 selected_frame_index: selected_frame_index,
                 selected_frame: selected_frame,
                 backtrace: backtrace %>

      <section class="better-errors-section">
        <h4>Request info</h4>
        <dl class="better-errors-dl">
          <% if request_details[:params].present? %>
            <dt>Request parameters</dt>
            <dd><code><%= pretty_context_json(request_details[:params]) %></code></dd>
          <% end %>
          <% if request_details[:request_id].present? %>
            <dt>Request ID</dt>
            <dd><code><%= request_details[:request_id] %></code></dd>
          <% end %>
          <% if request_details[:url].present? %>
            <dt>URL</dt>
            <dd><%= request_details[:url] %></dd>
          <% end %>
        </dl>
      </section>

      <section class="better-errors-section">
        <h4>Local Variables</h4>
        <% if local_variables.any? %>
          <dl class="better-errors-dl">
            <% local_variables.each do |key, value| %>
              <dt><code><%= key %></code></dt>
              <dd><code><%= value.is_a?(String) ? value : pretty_context_json(value) %></code></dd>
            <% end %>
          </dl>
        <% else %>
          <p class="muted">No local variables captured.</p>
        <% end %>
      </section>

      <section class="better-errors-section">
        <h4>Instance Variables</h4>
        <% if instance_variables.any? %>
          <dl class="better-errors-dl">
            <% instance_variables.each do |key, value| %>
              <dt><code><%= key %></code></dt>
              <dd><code><%= value.is_a?(String) ? value : pretty_context_json(value) %></code></dd>
            <% end %>
          </dl>
        <% else %>
          <p class="muted">No instance variables captured.</p>
        <% end %>
      </section>
    </div>
  </div>
</div>
