<%# locals: (project:, event:, group:, occurrences:, related_logs:, stacktrace_tab_label:, stacktrace_partial:, exception_data:, request_details:, frame_scope:, visible_frames:, selected_frame_index:, selected_frame:, source_excerpt:, source_lookup: nil, backtrace:, local_variables:, instance_variables:, variant_summary: nil, filter_param: "unresolved", query_param: "", assignee_param: "all", active_tab: "stacktrace", turbo_frame_id: nil, wrapper_classes: "detail-tabs-wrap", tour_group: nil) %>
<% filter_param = filter_param.presence || "unresolved" %>
<% query_param = query_param.to_s %>
<% assignee_param = assignee_param.presence || "all" %>
<% experience = project_experience(project) %>
<% sections = experience.detail_sections(event: event, occurrences_count: occurrences.size, related_logs_count: related_logs.size) %>
<% active_tab = experience.normalize_detail_tab(active_tab, event: event, occurrences_count: occurrences.size, related_logs_count: related_logs.size) %>
<% turbo_frame_id = turbo_frame_id.presence %>
<% wrapper_classes = wrapper_classes.presence || "detail-tabs-wrap" %>
<% link_data = turbo_frame_id.present? ? { turbo_frame: turbo_frame_id } : {} %>
<% error_detail = group.present? || event.error? %>
<% detail_scope_params = turbo_frame_id.present? ? { filter: filter_param, q: query_param, assignee: assignee_param, group_uuid: group&.uuid } : {} %>

<div class="<%= wrapper_classes %>"
     data-controller="frame-tabs"
     data-frame-tabs-turbo-frame-value="<%= turbo_frame_id %>"
     data-action="turbo:before-fetch-request@document->frame-tabs#onBeforeFetch turbo:frame-load@document->frame-tabs#onFrameLoad turbo:fetch-request-error@document->frame-tabs#onFetchError turbo:frame-missing@document->frame-tabs#onFetchError"
     data-project-experience="<%= experience.key %>"
     data-project-experience-version="<%= experience.version %>"
     <%= tag.attributes(data: product_tour_step_data(tour_group, :tabs)) if tour_group.present? %>
     aria-busy="false">
  <nav class="detail-tabs" role="tablist" aria-label="<%= error_detail ? "Issue details" : "Event details" %>" <% if turbo_frame_id.present? %>data-turbo-frame="<%= turbo_frame_id %>"<% end %>>
    <% sections.each do |section| %>
      <%= link_to section.label,
                  partitioned_project_event_path(project, event, detail_scope_params.merge(tab: section.key)),
                  id: "detail-tab-#{section.key}",
                  class: "detail-tab",
                  role: "tab",
                  aria: { controls: "tab-#{section.key.to_s.dasherize}", selected: (active_tab == section.key.to_s).to_s, current: ("page" if active_tab == section.key.to_s) },
                  tabindex: (active_tab == section.key.to_s ? 0 : -1),
                  data: link_data.merge(action: "click->frame-tabs#activate keydown->frame-tabs#navigate", frame_tabs_target: "tab") %>
    <% end %>
  </nav>

  <% sections.each do |section| %>
    <% section_key = section.key.to_s %>
    <section id="tab-<%= section_key.dasherize %>"
             class="detail-panel<%= " event-workspace event-workspace-#{project.integration_kind}" if section.key == :stacktrace %>"
             role="tabpanel"
             data-project-integration="<%= project.integration_kind if section.key == :stacktrace %>"
             aria-hidden="<%= active_tab == section_key ? 'false' : 'true' %>"
             <%= 'hidden' unless active_tab == section_key %>
             data-frame-tabs-target="panel">
      <%= render section.partial,
                 project: project,
                 event: event,
                 group: group,
                 occurrences: occurrences,
                 related_logs: related_logs,
                 stacktrace_partial: stacktrace_partial,
                 exception_data: exception_data,
                 request_details: request_details,
                 filter_param: filter_param,
                 query_param: query_param,
                 assignee_param: assignee_param,
                 source_excerpt: source_excerpt,
                 source_lookup: local_assigns[:source_lookup],
                 frame_scope: frame_scope,
                 visible_frames: visible_frames,
                 selected_frame_index: selected_frame_index,
                 selected_frame: selected_frame,
                 backtrace: backtrace,
                 local_variables: local_variables,
                 instance_variables: instance_variables,
                 variant_summary: variant_summary,
                 link_data: link_data,
                 experience: experience %>
    </section>
  <% end %>
</div>
