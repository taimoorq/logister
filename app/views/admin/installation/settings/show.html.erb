<% content_for :title, "#{@section.label} installation settings" %>

<%= render "admin/navigation" %>
<%= render "admin/installation/section_navigation" %>

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
  <div>
    <p class="kicker">Admin → Installation</p>
    <h1 class="mt-1 text-2xl font-bold text-slate-900"><%= @section.label %></h1>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600"><%= @section.description %></p>
  </div>
  <div class="flex shrink-0 items-center gap-2">
    <span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700"><%= @section.required? ? "Required" : "Optional" %></span>
    <span class="rounded-full border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-800"><%= @step.status.humanize %></span>
  </div>
</div>

<% if @diagnostic %>
  <section class="mb-6 rounded-xl border p-4 <%= @diagnostic.success? ? 'border-emerald-200 bg-emerald-50' : 'border-red-200 bg-red-50' %>" role="status">
    <h2 class="text-sm font-semibold <%= @diagnostic.success? ? 'text-emerald-900' : 'text-red-900' %>"><%= @diagnostic.success? ? "Check passed" : "Check failed" %></h2>
    <p class="mt-1 text-sm <%= @diagnostic.success? ? 'text-emerald-800' : 'text-red-800' %>"><%= @diagnostic.summary %></p>
    <% if @diagnostic.details.present? %>
      <dl class="mt-3 grid gap-2 text-xs sm:grid-cols-2">
        <% @diagnostic.details.each do |key, value| %>
          <div class="rounded-lg border border-black/10 bg-white/60 px-3 py-2">
            <dt class="font-semibold text-slate-600"><%= key.to_s.humanize %></dt>
            <dd class="mt-0.5 break-words text-slate-900"><%= value.is_a?(Array) ? (value.presence&.join(", ") || "None") : value %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
  </section>
<% end %>

<% if @section.key == "clickhouse" %>
  <section class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950">
    <h2 class="font-semibold">Use a staged cutover</h2>
    <p class="mt-1 leading-6">Start with dual write, repair the ClickHouse schema, backfill retained PostgreSQL events, then run the check below. Logister blocks read preferred until the stable 24-hour coverage window passes.</p>
    <div class="mt-3">
      <%= button_to "Repair ClickHouse schema",
                    admin_repair_installation_section_path(@section.key),
                    method: :post,
                    class: "btn-ghost cursor-pointer border-amber-300 bg-white text-amber-950 hover:bg-amber-100",
                    form: { data: { turbo_confirm: "Run the idempotent ClickHouse schema repair with the saved effective credentials?" } } %>
    </div>
  </section>
<% end %>

<%= form_with url: admin_installation_section_path(@section.key), method: :patch, local: true, class: "space-y-6" do %>
  <section class="rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-5 py-4">
      <h2 class="text-base font-semibold text-slate-900">Settings</h2>
      <p class="mt-1 text-sm text-slate-600">Saving stores an encrypted fallback. A nonblank environment variable remains effective until it is removed and the relevant processes restart.</p>
    </div>
    <div class="divide-y divide-slate-100">
      <% @entries.each do |entry| %>
        <% definition = entry.definition %>
        <div class="grid gap-3 px-5 py-5 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,1.25fr)] lg:gap-8">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <%= label_tag "setting_#{definition.key.parameterize(separator: '_')}", definition.label, class: "text-sm font-semibold text-slate-900" %>
              <% if definition.restart_required? %>
                <span class="rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-900">Restart required</span>
              <% end %>
            </div>
            <p class="mt-1 text-sm leading-5 text-slate-600"><%= definition.help %></p>
            <p class="mt-2 text-xs text-slate-500">Environment: <code><%= definition.env_key %></code></p>
          </div>
          <div>
            <% field_id = "setting_#{definition.key.parameterize(separator: '_')}" %>
            <% value = @form_values[definition.key] %>
            <% case definition.type %>
            <% when :boolean %>
              <%= hidden_field_tag "settings[#{definition.key}]", "0" %>
              <label class="inline-flex min-h-11 cursor-pointer items-center gap-3 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-800" for="<%= field_id %>">
                <%= check_box_tag "settings[#{definition.key}]", "1", ActiveModel::Type::Boolean.new.cast(value), id: field_id, class: "h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
                Enabled
              </label>
            <% when :select %>
              <%= select_tag "settings[#{definition.key}]", options_for_select(definition.options, value), id: field_id, class: "form-input" %>
            <% when :textarea_secret %>
              <%= text_area_tag "settings[#{definition.key}]", nil, id: field_id, rows: 7, autocomplete: "new-password", placeholder: definition.placeholder, class: "form-input font-mono text-xs" %>
            <% when :secret %>
              <%= password_field_tag "settings[#{definition.key}]", nil, id: field_id, autocomplete: "new-password", placeholder: definition.placeholder, class: "form-input" %>
            <% else %>
              <%= text_field_tag "settings[#{definition.key}]", value, id: field_id, inputmode: (definition.type == :integer ? "numeric" : nil), placeholder: definition.placeholder, class: "form-input" %>
            <% end %>

            <% if entry.environment_override? %>
              <div class="mt-2 rounded-lg border border-violet-200 bg-violet-50 px-3 py-2 text-xs leading-5 text-violet-900">
                <strong>Environment override active.</strong> <code><%= entry.active_environment_key %></code> is effective now.
                <% unless entry.secret? %>
                  Current effective value: <code class="break-all"><%= entry.effective_value %></code>.
                <% end %>
                You can still save a fallback for later.
              </div>
            <% elsif entry.source == :default %>
              <p class="mt-2 text-xs text-slate-500">Using the application default until a fallback is saved.</p>
            <% end %>

            <% if entry.secret? %>
              <p class="mt-2 text-xs text-slate-500"><%= entry.saved? ? "An encrypted fallback is saved. Leave blank to keep it." : "No encrypted fallback is saved." %></p>
            <% end %>

            <% if entry.saved? %>
              <label class="mt-2 inline-flex cursor-pointer items-center gap-2 text-xs font-medium text-slate-600">
                <%= check_box_tag "clear_keys[]", entry.key, false, class: "h-4 w-4 rounded border-slate-300 text-red-600 focus:ring-red-500" %>
                Remove the saved fallback
              </label>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <% if @section.key == "email" %>
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <%= label_tag :test_recipient, "Test recipient", class: "form-label" %>
      <%= email_field_tag :test_recipient, params[:test_recipient], placeholder: current_user.email, class: "form-input max-w-xl", aria: { describedby: "test-recipient-help" } %>
      <p id="test-recipient-help" class="mt-2 text-xs leading-5 text-slate-500">Optional. After saving SMTP settings, a check with a recipient submits one direct message and one queued message.</p>
    </section>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <%= submit_tag "Save settings", class: "btn-primary" %>
    <%= submit_tag "Test candidate values",
                   formaction: admin_test_installation_section_path(@section.key),
                   class: "btn-ghost cursor-pointer" %>
    <% unless @section.required? %>
      <%= link_to "Skip for now",
                  admin_skip_installation_section_path(@section.key),
                  data: { turbo_method: :post },
                  class: "text-sm font-semibold text-slate-600 hover:text-slate-900" %>
    <% end %>
    <% if @next_section %>
      <%= link_to "Next: #{@next_section.label}", admin_installation_section_path(@next_section.key), class: "text-sm font-semibold text-blue-700 hover:text-blue-900" %>
    <% end %>
    <%= link_to "Installation overview", admin_installation_path, class: "text-sm font-semibold text-slate-600 hover:text-slate-900" %>
  </div>
<% end %>

<section class="mt-8 rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-200 px-5 py-4">
    <h2 class="text-base font-semibold text-slate-900">Recent history</h2>
    <p class="mt-1 text-sm text-slate-600">Values and secrets are deliberately omitted from this audit trail.</p>
  </div>
  <% if @changes.any? %>
    <ul class="divide-y divide-slate-100">
      <% @changes.each do |change| %>
        <li class="flex flex-col gap-1 px-5 py-3 text-sm sm:flex-row sm:items-center sm:justify-between">
          <span class="text-slate-800"><strong><%= change.action.humanize %></strong> · <%= change.key.delete_prefix(@section.key + ".").humanize %> · <%= change.actor&.email || "system" %></span>
          <span class="text-xs text-slate-500"><%= local_time_tag(change.created_at, format: :long) %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="px-5 py-6 text-sm text-slate-600">No changes or checks have been recorded for this section.</p>
  <% end %>
</section>
