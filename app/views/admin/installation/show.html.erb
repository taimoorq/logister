<% content_for :title, "Installation" %>

<%= render "admin/navigation" %>

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
  <div>
    <p class="kicker">Admin</p>
    <h1 class="mt-1 text-2xl font-bold text-slate-900">Installation</h1>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">Configure and verify the services around Rails and PostgreSQL. Progress is saved, optional sections can be skipped, and every page remains available after onboarding.</p>
  </div>
  <% if @installation.complete? %>
    <span class="inline-flex shrink-0 items-center rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-sm font-semibold text-emerald-800">Setup complete</span>
  <% else %>
    <span class="inline-flex shrink-0 items-center rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-sm font-semibold text-amber-900">Setup in progress</span>
  <% end %>
</div>

<section class="mb-6 rounded-xl border border-blue-200 bg-blue-50 p-5 shadow-sm">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wider text-blue-700"><%= @installation.complete? ? "Installation maintenance" : "Recommended next step" %></p>
      <% if @next_required_section %>
        <h2 class="mt-1 text-xl font-semibold text-slate-900">Continue with <%= @next_required_section.label %></h2>
        <p class="mt-1 max-w-3xl text-sm leading-6 text-slate-700"><%= @required_verified_count %> of <%= @required_sections.length %> core checks are current. Finish General and Redis &amp; jobs before choosing optional services.</p>
      <% else %>
        <h2 class="mt-1 text-xl font-semibold text-slate-900">The core install is ready</h2>
        <p class="mt-1 max-w-3xl text-sm leading-6 text-slate-700">Choose an optional path only when it supports something your install needs. Every service stays available here later.</p>
      <% end %>
    </div>
    <% if @next_required_section %>
      <%= link_to "Continue with #{@next_required_section.label}", admin_installation_section_path(@next_required_section.slug), class: "btn-primary shrink-0" %>
    <% end %>
  </div>
</section>

<section class="mb-6">
  <div class="mb-3">
    <p class="kicker"><%= @installation.complete? ? "Core services" : "1. Finish the core install" %></p>
    <h2 class="mt-1 text-xl font-semibold text-slate-900">Two checks make the instance usable.</h2>
    <p class="mt-1 text-sm leading-6 text-slate-600">Set the canonical instance details, then prove Redis and a Sidekiq worker are connected.</p>
  </div>
  <div class="grid gap-4 md:grid-cols-2">
    <% @required_sections.each do |section| %>
      <% state = @section_states.fetch(section.key) %>
      <% status = state.fetch(:status) %>
      <% status_classes = case status
                          when "verified" then "border-emerald-200 bg-emerald-50 text-emerald-800"
                          when "changed" then "border-amber-200 bg-amber-50 text-amber-900"
                          else "border-blue-200 bg-blue-50 text-blue-800"
                          end %>
      <section class="flex min-h-52 flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Core check</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-900"><%= section.label %></h3>
          </div>
          <span class="rounded-full border px-2.5 py-1 text-xs font-semibold <%= status_classes %>"><%= status.humanize %></span>
        </div>
        <p class="mt-3 flex-1 text-sm leading-6 text-slate-600"><%= section.description %></p>
        <div class="mt-4 border-t border-slate-100 pt-4">
          <%= link_to status == "verified" ? "Review settings" : "Configure and verify", admin_installation_section_path(section.slug), class: "inline-link" %>
        </div>
      </section>
    <% end %>
  </div>
</section>

<section class="mb-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div class="max-w-2xl">
      <p class="kicker">Choose where settings live</p>
      <h2 class="mt-1 text-lg font-semibold text-slate-900">Use the UI, environment variables, or both.</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">Nonblank environment values win. Logister keeps encrypted UI values as fallbacks for later and labels every active override without displaying secret values.</p>
    </div>
    <div class="rounded-lg border border-violet-200 bg-violet-50 px-4 py-3 lg:w-56">
      <p class="text-xs font-semibold uppercase tracking-wider text-violet-700">Active overrides</p>
      <p class="mt-1 text-2xl font-bold text-violet-950"><%= @environment_override_count %></p>
      <p class="mt-1 text-xs leading-5 text-violet-900">Open a settings page to see which fields are controlled by the environment.</p>
    </div>
  </div>
</section>

<section class="mb-6">
  <div class="mb-3">
    <p class="kicker"><%= @installation.complete? ? "Optional services" : "2. Add only what you need" %></p>
    <h2 class="mt-1 text-xl font-semibold text-slate-900">Pick a path by the outcome you want.</h2>
    <p class="mt-1 text-sm leading-6 text-slate-600">Optional services can be skipped during onboarding. Return here when your users, traffic, storage, or operating model needs one.</p>
  </div>
  <div class="grid gap-4 lg:grid-cols-2">
    <% @optional_groups.each do |group| %>
      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h3 class="text-base font-semibold text-slate-900"><%= group.fetch(:label) %></h3>
        <p class="mt-1 text-sm leading-6 text-slate-600"><%= group.fetch(:description) %></p>
        <ul class="mt-4 divide-y divide-slate-100 border-y border-slate-100">
          <% group.fetch(:sections).each do |section| %>
            <% status = @section_states.fetch(section.key).fetch(:status) %>
            <% status_classes = case status
                                when "verified" then "border-emerald-200 bg-emerald-50 text-emerald-800"
                                when "skipped" then "border-slate-200 bg-slate-100 text-slate-700"
                                when "changed" then "border-amber-200 bg-amber-50 text-amber-900"
                                else "border-blue-200 bg-blue-50 text-blue-800"
                                end %>
            <li class="flex items-center justify-between gap-4 py-3">
              <div class="min-w-0">
                <p class="font-semibold text-slate-900"><%= section.label %></p>
                <p class="mt-0.5 text-xs leading-5 text-slate-500"><%= section.description %></p>
              </div>
              <div class="flex shrink-0 items-center gap-3">
                <span class="hidden rounded-full border px-2 py-0.5 text-[11px] font-semibold sm:inline-flex <%= status_classes %>"><%= status.humanize %></span>
                <%= link_to "Open", admin_installation_section_path(section.slug), class: "inline-link" %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</section>

<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-base font-semibold text-slate-900"><%= @installation.complete? ? "Core checks complete" : "Finish onboarding" %></h2>
      <p class="mt-1 text-sm leading-5 text-slate-600"><%= @installation.complete? ? "Return here after any service, credential, or environment change." : "Complete installation after General and Redis & jobs have current passing checks." %></p>
    </div>
    <% unless @installation.complete? %>
      <%= button_to "Complete installation",
                    complete_admin_installation_path,
                    method: :post,
                    disabled: !@installation.required_steps_verified?,
                    class: "btn-primary shrink-0 disabled:cursor-not-allowed disabled:opacity-50" %>
    <% end %>
  </div>
</section>
