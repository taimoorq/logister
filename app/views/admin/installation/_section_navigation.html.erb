<nav class="mb-6 overflow-x-auto rounded-xl border border-slate-200 bg-white p-2 shadow-sm" aria-label="Installation sections">
  <div class="flex min-w-max gap-1">
    <% InstanceConfiguration::Registry.sections.each do |section| %>
      <% active = defined?(@section) && @section.key == section.key %>
      <%= link_to section.label,
                  admin_installation_section_path(section.key),
                  class: "rounded-lg px-3 py-2 text-sm font-medium no-underline #{active ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'}",
                  aria: (active ? { current: "page" } : {}) %>
    <% end %>
  </div>
</nav>
