<%= form_with model: @project, url: new_project_step_path("retention"), method: :get, scope: :project do |f| %>
  <div class="wz-main-body">
    <p class="setup-kicker">Step 2 of 4 · <%= @project.integration_label %></p>
    <h1 id="wz-step-title">Name the project</h1>
    <p class="wz-lead">A short name your team will recognize. Logister derives the URL slug from it.</p>

    <div class="wz-columns">
      <div class="flex max-w-xl flex-col gap-5">
        <div>
          <%= f.label :name, class: "form-label" %>
          <%= f.text_field :name, required: true, autofocus: true, class: "form-input" %>
        </div>
        <div>
          <%= f.label :description, "Description (optional)", class: "form-label" %>
          <%= f.text_area :description, rows: 4, class: "form-input" %>
        </div>
        <% if admin_user? && @project.integration_ruby? %>
          <%= render "projects/self_monitoring_destination", current_project: @current_self_monitoring_project %>
        <% end %>
        <%= project_creation_carry_fields(@carried, owns: %w[name description monitor_this_installation]) %>
      </div>
      <%= render "project_creation_steps/preview", project: @project %>
    </div>
  </div>

  <footer class="wz-footer">
    <%= link_to "Back", new_project_step_path("platform", Rack::Utils.parse_nested_query(@carried.to_query)), class: "btn-ghost" %>
    <div class="wz-footer-right">
      <button type="submit" class="btn-primary">Continue: Data retention</button>
    </div>
  </footer>
<% end %>
