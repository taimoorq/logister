<%# locals: (project:) %>
<% experience = project.integration_definition.default_experience_key %>
<% steps = ProjectSetupCatalog.steps_for(experience).select { |step| step.group.required? } %>
<aside class="wz-panel self-start" aria-labelledby="creation-preview-title">
  <p class="setup-kicker">After you create it</p>
  <h2 id="creation-preview-title"><%= project.integration_label %> setup path</h2>
  <ol class="mt-3 flex list-none flex-col gap-2.5 p-0 text-[13px]">
    <% steps.each_with_index do |step, index| %>
      <li class="flex gap-2.5">
        <span class="setup-marker !h-5 !w-5 text-[11px]"><%= index + 1 %></span>
        <span>
          <%= step.label %>
          <span class="block text-xs" style="color: var(--app-muted)"><%= step.owner == :code ? (step.owner_label || "Your code or CI") : "Done in Logister" %></span>
        </span>
      </li>
    <% end %>
  </ol>
  <p>Then optional steps: source repository, deployments, teammates. You can leave setup at any point. Progress is saved on the project.</p>
</aside>
