# fly.toml app configuration template
# Copy this file to fly.toml for local/private Fly.io deployment config.
#
# cp fly.toml.example fly.toml
# See https://fly.io/docs/reference/configuration/

app = 'your-app-name'
primary_region = 'iad'
console_command = '/rails/bin/rails console'

[build]

[deploy]
  release_command = './bin/rails db:prepare'

[env]
  PORT = '8080'

[processes]
  app = './bin/rails server -b 0.0.0.0 -p 8080'
  worker = 'bundle exec sidekiq -C config/sidekiq.yml'
# Larger installations can replace `worker` with independently scalable roles:
# projector = 'bundle exec sidekiq -q projector -c 5'
# analytics = 'bundle exec sidekiq -q analytics -c 3'
# notifications = 'bundle exec sidekiq -q notifications -q mailers -q default -c 3'
# integrations = 'bundle exec sidekiq -q integrations -q symbols -c 2'
# maintenance = 'bundle exec sidekiq -q maintenance -c 1'

# Keep either the combined worker or every split role running in production.
# Configure DB_POOL to at least the largest process concurrency plus two.

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = 'stop'
  auto_start_machines = true
  min_machines_running = 0
  processes = [ 'app' ]

  [[http_service.checks]]
    interval = '10s'
    timeout = '2s'
    grace_period = '15s'
    method = 'GET'
    path = '/up'
    protocol = 'http'
    tls_skip_verify = false

    [http_service.checks.headers]
      X-Forwarded-Proto = 'https'

[[vm]]
  memory = '1gb'
  cpu_kind = 'shared'
  cpus = 1
  memory_mb = 1024
