# Logister environment template.
#
# This file is safe to commit because every sensitive value is blank or a
# placeholder. Do not put production secrets in this file. Store real values in
# Fly secrets, your container orchestrator, Rails credentials, or another secret
# manager.
#
# After the Rails web process and PostgreSQL are available, claim a fresh
# instance at /setup and configure the rest under Admin -> Installation.
# Nonblank environment variables always override saved UI values. The UI keeps
# encrypted fallbacks so operators can remove an override later without losing
# the intended setting.

# Rails runtime
RAILS_ENV=development
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info
# Set PORT when your platform does not inject one for the web process.
# PORT=3000
# Set WEB_CONCURRENCY only when you want multiple Puma workers per web process.
# WEB_CONCURRENCY=1
# Required in production. Store this in your deploy provider, not in the repo.
# RAILS_MASTER_KEY=

# First administrator and app URLs
# Required only while claiming a fresh instance. Generate a long random value,
# open /setup, then remove this variable after the first administrator exists.
LOGISTER_SETUP_TOKEN=
# Optional break-glass admin allow-list for existing users. The first operator
# created through /setup receives a durable database-backed admin role.
# LOGISTER_ADMIN_EMAILS=you@example.com
# Public URL used for links in emails and generated metadata.
# In production, set this to the canonical HTTPS URL for your self-hosted app.
LOGISTER_PUBLIC_URL=https://your-logister-host.example
# Public docs URL used by in-app documentation links.
LOGISTER_DOCS_URL=https://logister.org/docs
# Prefix for newly generated project API tokens.
LOGISTER_API_KEY_PREFIX=logister
# Public ingestion API rate limits. A coarse source-IP ceiling runs before any
# credential lookup. Accepted requests and confirmed authentication failures
# then use separate counters so successful traffic is not recorded as failure.
LOGISTER_PUBLIC_API_RATE_LIMIT_REQUESTS=1200
LOGISTER_PUBLIC_API_RATE_LIMIT_PERIOD_SECONDS=60
LOGISTER_PUBLIC_API_PRE_AUTH_RATE_LIMIT_REQUESTS=12000
LOGISTER_PUBLIC_API_AUTH_FAILURE_RATE_LIMIT_REQUESTS=120

# GitHub App source integration (optional)
# Enables private repository source excerpts, CODEOWNERS hints, repository sync,
# GitHub issue creation when issues:write is granted, and deployment/source links.
# LOGISTER_GITHUB_APP_ID=
# LOGISTER_GITHUB_APP_PRIVATE_KEY=
# LOGISTER_GITHUB_WEBHOOK_SECRET=
# LOGISTER_GITHUB_APP_SLUG=
# LOGISTER_GITHUB_APP_INSTALL_URL=
# LOGISTER_GITHUB_API_URL=https://api.github.com
# LOGISTER_GITHUB_WEB_URL=https://github.com
# LOGISTER_GITHUB_API_VERSION=2026-03-10
# Optional GitHub rollout/testing override for App installation tokens.
# Use "enabled" to request GitHub's stateless S2S token format or "disabled"
# only as a temporary fallback while diagnosing a GitHub rollout issue.
# LOGISTER_GITHUB_STATELESS_S2S_TOKEN=enabled

# Redis / background jobs
# REDIS_URL remains the small-install default for all three roles. At scale,
# isolate evictable cache/rate-limit data from durable Sidekiq queues.
REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_CACHE_URL=redis://127.0.0.1:6379/1
# REDIS_RATE_LIMIT_URL=redis://127.0.0.1:6379/2
# REDIS_SIDEKIQ_URL=redis://127.0.0.1:6379/3
# For a production Compose stack with a redis service:
# REDIS_URL=redis://redis:6379/0
# For Redis Cloud / redis.io in production, use TLS URL format:
# REDIS_URL=rediss://default:<password>@<host>:<port>/0
# Default used by config/sidekiq.yml. An explicit Sidekiq -c value takes precedence.
SIDEKIQ_CONCURRENCY=5

# PostgreSQL
# For Postgres.app local default:
DATABASE_URL=postgresql://127.0.0.1:5432/logister_development
# Each process has its own database pool. Sidekiq needs at least its concurrency
# plus two connections of operational headroom.
DB_POOL=7
# For Docker Compose postgres service instead:
# DATABASE_URL=postgresql://logister:logister@127.0.0.1:5432/logister_development
# For a production Compose stack, use the service name and your real password:
# DATABASE_URL=postgresql://logister:<password>@postgres:5432/logister_production
# For managed providers with separate migration/admin URLs, such as Prisma Postgres:
# DATABASE_URL=<provider-pooled-postgres-url>
# DATABASE_MIGRATION_URL=<provider-direct-postgres-url>

# Optional self-observability
# Set these if you want the Logister app itself to send events to a Logister project.
# LOGISTER_API_KEY=
# LOGISTER_ENDPOINT=https://your-logister-host.example/api/v1/ingest_events
# LOGISTER_DEPLOYMENT_ENDPOINT=https://your-logister-host.example/api/v1/deployments
# LOGISTER_RELEASE=
# LOGISTER_REPOSITORY=your-org/logister
# LOGISTER_COMMIT_SHA=
# LOGISTER_BRANCH=main
# LOGISTER_DEPLOYED_AT=
# LOGISTER_WORKFLOW_RUN_URL=
# LOGISTER_COMMIT_URL=
# Set false when a private self-hosted install should not call GitHub daily to
# check whether a newer Logister release is available for operator notifications.
LOGISTER_UPDATE_CHECKS_ENABLED=true
# These knobs control which app-health events are captured when self-observability is configured.
# Keep them enabled for production diagnosis unless event volume becomes noisy.
LOGISTER_CAPTURE_REQUEST_SPANS=true
LOGISTER_CAPTURE_DB_METRICS=true
LOGISTER_DB_METRIC_MIN_DURATION_MS=250
LOGISTER_DB_METRIC_SAMPLE_RATE=1.0
LOGISTER_CAPTURE_SQL_BREADCRUMBS=true
LOGISTER_SQL_BREADCRUMB_MIN_DURATION_MS=25
LOGISTER_CAPTURE_WEB_REQUEST_TRANSACTIONS=true
LOGISTER_WEB_REQUEST_MIN_DURATION_MS=250
LOGISTER_WEB_REQUEST_LOG_MIN_DURATION_MS=1000
# Send one test burst through the Ruby integration after self-observability is configured:
# bin/rails logister:sample_telemetry

# Read-only CLI API rollout
# New API 3.5 read routes deploy before the CLI v1.0.0 package release. These
# discovery flags fail closed and remain off until every package channel has
# been verified. Accepted true values are: 1, true, yes, or on.
LOGISTER_CLI_FEATURE_TRACES=false
LOGISTER_CLI_FEATURE_MONITORS=false
LOGISTER_CLI_FEATURE_DEPLOYMENTS=false
LOGISTER_CLI_FEATURE_INSIGHTS=false
LOGISTER_CLI_FEATURE_METRICS=false
# Keep the existing recommendation through the disabled-capability deploy.
LOGISTER_CLI_MINIMUM_VERSION=0.1.0
LOGISTER_CLI_RECOMMENDED_VERSION=0.1.2
# Authenticated CLI reads are limited per token. A 2-second follow poll is well
# below this default; cache outages fail open so observability cannot block reads.
LOGISTER_CLI_READ_RATE_LIMIT_REQUESTS=600
LOGISTER_CLI_READ_RATE_LIMIT_PERIOD_SECONDS=60

# ClickHouse (optional, recommended for scale)
# Preferred activation setting: disabled, dual_write, or read_preferred.
# Use dual_write only while populating and verifying ClickHouse; dashboards still
# read PostgreSQL in this mode. After schema and retained-event coverage pass,
# switch to read_preferred to move supported analytics reads to ClickHouse.
LOGISTER_CLICKHOUSE_MODE=disabled
# Legacy boolean override. true maps only to dual_write and cannot enable
# ClickHouse reads. Remove it when using LOGISTER_CLICKHOUSE_MODE or the Admin UI.
# LOGISTER_CLICKHOUSE_ENABLED=false
LOGISTER_CLICKHOUSE_URL=http://127.0.0.1:8123
# For a production Compose stack with a clickhouse service:
# LOGISTER_CLICKHOUSE_URL=http://clickhouse:8123
LOGISTER_CLICKHOUSE_DATABASE=logister
LOGISTER_CLICKHOUSE_EVENTS_TABLE=events_raw
LOGISTER_CLICKHOUSE_SPANS_TABLE=spans_raw
LOGISTER_CLICKHOUSE_USERNAME=default
LOGISTER_CLICKHOUSE_PASSWORD=
# Optional DDL credentials used only by bin/release for schema repair.
# LOGISTER_CLICKHOUSE_MIGRATION_USERNAME=logister_schema
# LOGISTER_CLICKHOUSE_MIGRATION_PASSWORD=
# Prevent a single ClickHouse outage from creating a self-monitoring event storm.
LOGISTER_CLICKHOUSE_FAILURE_THROTTLE_SECONDS=60
# Stop sending during a sustained outage, then allow one half-open recovery probe.
LOGISTER_CLICKHOUSE_CIRCUIT_FAILURE_THRESHOLD=5
LOGISTER_CLICKHOUSE_CIRCUIT_OPEN_SECONDS=30
# Server-side bound used by the purge quiescence guarantee for ambiguous requests.
LOGISTER_CLICKHOUSE_MAX_EXECUTION_SECONDS=30
# Deterministically shadow this fraction of complete ClickHouse reads against
# PostgreSQL during the transition window (0 disables, 1 compares every read).
LOGISTER_CLICKHOUSE_DUAL_READ_SAMPLE_RATE=0.01
# Project purge uses synchronous ClickHouse mutations and remains visibly paused
# until an operator has validated permissions and explicitly enables this gate.
# LOGISTER_ENABLE_PROJECT_PURGE_CLICKHOUSE=false
# Fail-closed deletion attestations. Set only after inventorying every ClickHouse
# cluster ever used by this installation, or after proving ClickHouse was never used.
# LOGISTER_ATTEST_CLICKHOUSE_GENERATION_INVENTORY_COMPLETE=false
# LOGISTER_ATTEST_CLICKHOUSE_NEVER_USED=false
# Optional secret JSON map: {"<generation-id>":{"username":"...","password":"..."}}
# LOGISTER_PROJECT_PURGE_CLICKHOUSE_CREDENTIALS_JSON=
# Quiescence and repeated-verification windows for ambiguous remote writes.
# LOGISTER_PROJECT_PURGE_WRITE_QUIESCENCE_SECONDS=120
# LOGISTER_PROJECT_PURGE_FINAL_VERIFICATION_SECONDS=30
# Optional comma-separated project-scoped fact/rollup tables beyond the built-ins.
# LOGISTER_PROJECT_PURGE_CLICKHOUSE_TABLES=

# S3 / telemetry archive storage
# Set ACTIVE_STORAGE_SERVICE=amazon in production when you want telemetry
# archives or uploaded files to use S3 instead of local disk.
ACTIVE_STORAGE_SERVICE=local
# For hosted deployments, prefer a least-privilege IAM user or role scoped to
# the telemetry archive bucket/prefix. Self-hosters can swap these for their own
# AWS account, bucket, or S3-compatible provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Optional for S3-compatible storage providers.
# AWS_S3_ENDPOINT=
# AWS_S3_FORCE_PATH_STYLE=false
LOGISTER_ARCHIVE_PREFIX=telemetry
# Required only to clean up pre-locator archives after proving they still reside
# in the currently configured store.
# LOGISTER_ATTEST_LEGACY_ARCHIVE_STORAGE_CURRENT=false
# Optional: send telemetry archives to a named storage.yml service without
# changing the default Active Storage service used by app uploads.
# LOGISTER_ARCHIVE_STORAGE_SERVICE=amazon

# Cloudflare Turnstile for Devise sign-in/sign-up forms
LOGISTER_TURNSTILE_ENABLED=false
LOGISTER_TURNSTILE_SITE_KEY=
LOGISTER_TURNSTILE_SECRET_KEY=

# Outbound email (Amazon SES SMTP)
LOGISTER_EMAIL_FROM=support@logister.org
SES_REGION=us-east-1
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
# SES_SMTP_ADDRESS=email-smtp.us-east-1.amazonaws.com
# SES_SMTP_PORT=587
# SES_SMTP_DOMAIN=logister.org
# SES_SMTP_ENABLE_STARTTLS_AUTO=true
# SES_SMTP_OPEN_TIMEOUT=5
# SES_SMTP_READ_TIMEOUT=5
# Optional SES configuration set for bounce/complaint/open delivery metrics.
# SES_CONFIGURATION_SET=logister-production

# Cookie Consent (Probo)
# Set to false to disable the banner entirely.
LOGISTER_COOKIE_CONSENT_ENABLED=true
# Analytics tags render by default in production only.
# Set true to render analytics tags in development/staging for verification.
LOGISTER_ANALYTICS_ENABLED=false
# Probo banner configuration. Set these in your deploy environment.
# PROBO_COOKIE_BANNER_SCRIPT_URL=https://cdn.jsdelivr.net/npm/@probo/cookie-banner/dist/cookie-banner.iife.js
PROBO_COOKIE_BANNER_ID=
# The Rails app proxies this upstream by default so browser requests stay same-origin.
PROBO_COOKIE_BANNER_BASE_URL=
PROBO_COOKIE_BANNER_PROXY_ENABLED=true
PROBO_COOKIE_BANNER_POSITION=bottom-left
# Must match the Probo category slug used for analytics cookies.
LOGISTER_ANALYTICS_COOKIE_CATEGORY=analytics

# Google Analytics (gtag) measurement ID, e.g. G-XXXXXXXXXX.
# In open source forks, use your own property ID.
# Analytics scripts are consent-gated and only run when both
# LOGISTER_COOKIE_CONSENT_ENABLED=true and GOOGLE_TAG_ID is set.
# GOOGLE_TAG_ID=

# Cloudflare Web Analytics token (optional).
# In open source forks, use your own Cloudflare token.
# Analytics scripts are consent-gated and only run when both
# LOGISTER_COOKIE_CONSENT_ENABLED=true and CLOUDFLARE_WEB_ANALYTICS_TOKEN is set.
# CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Cloudflare Pages docs deployment
# These are GitHub Actions / Cloudflare Pages settings, not Rails runtime values.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_PAGES_PROJECT=
# DOCS_PROBO_COOKIE_BANNER_ID=
# DOCS_PROBO_COOKIE_BANNER_BASE_URL=
# DOCS_PROBO_COOKIE_BANNER_POSITION=
# DOCS_ANALYTICS_COOKIE_CATEGORY=analytics
# DOCS_GOOGLE_TAG_ID=
# DOCS_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
